---
import "../styles/global.css";
import { generatedAt, tools } from "../lib/data.ts";
import { SHOW_STARS_FROM, SITE_REPO, siteStars } from "../lib/repo-stars.ts";
import { CANDIDATE_PRS, DISCOVERY_PRS, DISCOVERY_UTC } from "../lib/discovery.ts";

interface Props {
  title?: string;
  description?: string;
  /** Share image (site-relative path), e.g. the game cover on project pages. */
  image?: string;
  /** schema.org data for search engines, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}
const { title, description = "A tracker for playable static recompilations and source ports of classic games.", image, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · recomp.party` : "recomp.party — playable recomps & ports";
/** short: the label on phones, where all the links share one row */
const nav: { href: string; label: string; short?: string; count?: number }[] = [
  { href: "/", label: "Games" },
  { href: "/tools/", label: "Toolchains", short: "Tools", count: tools.length },
  { href: "/models/", label: "Models" },
  { href: "/explained/", label: "Explain" },
  { href: "/about/", label: "About" },
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d14" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(here, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="recomp.party" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {/* covers are portrait: the small card crops them least */}
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="recomp.party releases" href="/feed.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...jsonLd }).replaceAll("<", "\\u003c")} />}
    <script is:inline data-goatcounter="https://alfaiotadev.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">recomp<span>.party</span></a>
      <script is:inline>
        // A different party animation on every page load (sprites in src/assets, styles in global.css).
        (() => {
          const all = ["tada", "disco", "fireworks", "bubbly", "robot"];
          let last = null;
          try { last = sessionStorage.getItem("pop"); } catch {}
          const pick = all.filter((n) => n !== last)[Math.floor(Math.random() * (all.length - 1))];
          document.currentScript.previousElementSibling.dataset.pop = pick;
          try { sessionStorage.setItem("pop", pick); } catch {}
        })();
      </script>
      <div class="pills">
      <a
        class="scan"
        href={DISCOVERY_PRS}
        data-scan={JSON.stringify(DISCOVERY_UTC)}
        title={`Discovery scans GitHub and the web for new recomps every day at ${String(DISCOVERY_UTC.hour).padStart(2, "0")}:${String(DISCOVERY_UTC.minute).padStart(2, "0")} UTC; GitHub often starts it hours late, so the badge shows the real run state. Click for its proposals.`}
      >
        <span class="radar" aria-hidden="true"></span>
        <span class="scan-label">next scan</span>
        <span class="scan-t">T-··:··:··</span>
      </a>
      <a
        class="fresh"
        href="https://github.com/alfaiotadev/recomp.party/actions/workflows/fetch.yml"
        data-fresh={generatedAt}
        title={`GitHub data last fetched ${generatedAt.slice(0, 16).replace("T", " ")} UTC; it refreshes every six hours. Click for the fetch runs.`}
      >
        <span class="fresh-label">updated</span>
        <span class="fresh-t">··:·· ago</span>
      </a>
      <a class="review" href={CANDIDATE_PRS} data-review hidden>
        <span class="review-n"></span>
        <span class="review-label">in review</span>
      </a>
      <a class="gh-star-btn" href={`https://github.com/${SITE_REPO}`} title="Like the list? Star it on GitHub, it helps others find it.">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" /></svg>
        <span class="star-label">Star</span>
        {siteStars !== undefined && siteStars >= SHOW_STARS_FROM && <span class="star-n">{siteStars.toLocaleString("en")}</span>}
      </a>
      </div>
      <nav>
        {
          nav.map((n) => (
            <a href={n.href} aria-current={(n.href === "/" ? here === "/" : here.startsWith(n.href)) ? "page" : undefined}>
              {n.short ? (
                <>
                  <span class="nav-long">{n.label}</span>
                  <span class="nav-short">{n.short}</span>
                </>
              ) : (
                n.label
              )}
              {n.count !== undefined && <span class="nav-count">{n.count}</span>}
            </a>
          ))
        }
        <a href="/feed.xml" title="RSS feed of new releases">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Data from the GitHub API, refreshed every six hours. Game facts from <a href="https://www.wikidata.org/">Wikidata</a>,
        cover art from <a href="https://www.igdb.com/">IGDB</a>. Curated by hand, with AI-assisted suggestions.{" "}
        <a href="https://github.com/alfaiotadev/recomp.party">Source &amp; submissions on GitHub</a>.
      </p>
      <p>
        recomp.party links to projects; it hosts no games or game files. All projects require your own legally obtained
        copy of the game.
      </p>
      <p>
        Visits and outbound clicks are counted with <a href="https://www.goatcounter.com/">GoatCounter</a>: no cookies, no
        personal data.
      </p>
    </footer>
    <script>
      import "../scripts/decode.ts";
      import "../scripts/scan.ts";
      import "../scripts/fresh.ts";
      import "../scripts/review.ts";
      import "../scripts/outbound.ts";
    </script>
  </body>
</html>
