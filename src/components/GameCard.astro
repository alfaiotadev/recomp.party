---
import { ago, entryPath, fitLogoArea, KINDS, PLATFORMS, platformMark, type Entry } from "../lib/data.ts";

interface Props {
  entry: Entry;
}
const { entry: e } = Astro.props;
const searchText = [e.game, e.repo, e.tool, PLATFORMS[e.platform], e.meta?.title].filter(Boolean).join(" ").toLowerCase();
const mark = platformMark(e.platform);
const box = mark && fitLogoArea(mark, 900, 80, 16);
const [owner, name] = e.repo.split("/");
---

<li class={`card ${e.kind}${e.cover ? "" : " no-cover"}`} data-platform={e.platform} data-kind={e.kind} data-os={e.os.join(" ")} data-search={searchText}>
  {
    e.cover ? (
      <img class="art" src={e.cover.src} width={e.cover.width} height={e.cover.height} alt="" loading="lazy" decoding="async" />
    ) : (
      mark && box && <img class="art-mark" src={mark.src} width={box.w * 2.6} height={box.h * 2.6} alt="" loading="lazy" />
    )
  }
  <div class="top">
    <span class={`badge ${e.kind}`} title={KINDS[e.kind]}>{e.kind}</span>
    {e.snap?.archived && <span class="badge">archived</span>}
    <span class="plat" title={PLATFORMS[e.platform]}>
      {mark && box ? <img class="logo-img" src={mark.src} width={box.w.toFixed(1)} height={box.h.toFixed(1)} alt={PLATFORMS[e.platform]} /> : PLATFORMS[e.platform]}
    </span>
  </div>
  <div class="body">
    <h3><a href={entryPath(e)}>{e.game}</a></h3>
    <p class="repo">{owner}/<wbr />{name}{e.tool && <span class="tool"> · {e.tool}</span>}</p>
    {
      e.latest ? (
        <p class="release">
          <a href={e.latest.url}>{e.latest.name && e.latest.name.length <= 26 ? e.latest.name : e.latest.tag}</a>
          {e.latest.prerelease && <span class="badge pre">pre</span>}
          <span class="when">{ago(e.latest.publishedAt)}</span>
        </p>
      ) : (
        <p class="release muted">No release yet</p>
      )
    }
  </div>
</li>

<script>
  // Hover: the cover pans so that each corner of the card shows that corner of the cover, and pointing at
  // the text fades it out for a look at the whole cover. Mouse only; touch keeps the static card.
  const EDGE = 0.15; // the outer 15 % of each side already maps to that edge
  const map = (x: number) => Math.min(1, Math.max(0, (x - EDGE) / (1 - 2 * EDGE))).toFixed(3);
  for (const card of document.querySelectorAll<HTMLElement>("#games .card:not(.no-cover)")) {
    const body = card.querySelector<HTMLElement>(".body")!;
    card.addEventListener("pointermove", (ev) => {
      if (ev.pointerType !== "mouse") return;
      const r = card.getBoundingClientRect();
      card.style.setProperty("--u", map((ev.clientX - r.left) / r.width));
      card.style.setProperty("--v", map((ev.clientY - r.top) / r.height));
      card.classList.toggle("peek", ev.clientY >= body.getBoundingClientRect().top);
    });
    card.addEventListener("pointerleave", () => {
      card.style.removeProperty("--u");
      card.style.removeProperty("--v");
      card.classList.remove("peek");
    });
  }
</script>

<style>
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    list-style: none;
    aspect-ratio: 3 / 4.1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--surface);
    border: 1px solid rgb(255 255 255 / 0.06);
    border-radius: 10px;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }
  .card:hover {
    transform: translateY(-1px);
  }
  .card.recomp:hover {
    border-color: rgb(124 240 197 / 0.45);
    box-shadow: 0 0 0 1px rgb(124 240 197 / 0.15), 0 8px 30px -12px rgb(124 240 197 / 0.35);
  }
  .card.port:hover {
    border-color: rgb(255 179 92 / 0.45);
    box-shadow: 0 0 0 1px rgb(255 179 92 / 0.15), 0 8px 30px -12px rgb(255 179 92 / 0.35);
  }
  .card[hidden] {
    display: none;
  }

  /* --u/--v: pointer position over the card, 0…1. object-position pans the part object-fit crops away, and
     scaling around the same point keeps that corner of the cover pinned to the card's corner, so the
     edges never show. will-change keeps the layer composited: no snap on the last animation frame. */
  .art {
    --o: calc(var(--u, 0.5) * 100%) calc(var(--v, 0.5) * 100%);
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--o);
    transform-origin: var(--o);
    scale: 1.15;
    transition:
      scale 0.5s ease-out,
      object-position 0.35s ease-out,
      transform-origin 0.35s ease-out;
    will-change: transform;
    backface-visibility: hidden;
  }
  .card:hover .art {
    scale: 1.1;
  }
  @media (prefers-reduced-motion: reduce) {
    .art {
      --o: 50% 50%;
      transition: none;
    }
  }
  /* top shade behind the badges */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(11 13 20 / 0.55) 0, transparent 20%);
    pointer-events: none;
  }
  /* bottom shade behind the text; fades out with the text while the pointer is over it */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, transparent 32%, rgb(11 13 20 / 0.6) 50%, rgb(11 13 20 / 0.96) 68%);
    transition: opacity 0.35s ease-out;
    pointer-events: none;
  }
  .body {
    padding: 0 0.8rem 0.75rem;
    transition: opacity 0.35s ease-out;
  }
  .card.peek::after,
  .card.peek .body {
    opacity: 0;
  }
  .card.peek .release {
    pointer-events: none; /* an invisible link must not catch the click: it goes to the card link */
  }

  /* No cover yet: kind-coloured glow and a large faint platform mark. */
  .no-cover {
    background:
      radial-gradient(120% 70% at 50% 0%, rgb(124 240 197 / 0.1), transparent 70%),
      var(--surface);
  }
  .no-cover.port {
    background:
      radial-gradient(120% 70% at 50% 0%, rgb(255 179 92 / 0.1), transparent 70%),
      var(--surface);
  }
  .no-cover::after {
    display: none;
  }
  .art-mark {
    position: absolute;
    top: 34%;
    left: 50%;
    z-index: -2;
    max-width: 70%;
    height: auto;
    translate: -50% -50%;
    filter: brightness(0) invert(1);
    opacity: 0.07;
  }

  .top {
    position: absolute;
    top: 0.6rem;
    left: 0.65rem;
    right: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .top .badge {
    background: rgb(11 13 20 / 0.7);
    backdrop-filter: blur(4px);
  }
  .plat {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 1.25rem;
    padding: 0 0.45rem;
    border-radius: 4px;
    background: rgb(11 13 20 / 0.7);
    backdrop-filter: blur(4px);
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--fg);
  }
  .plat .logo-img {
    display: block;
    opacity: 0.9;
  }
  h3 {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.25;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.8);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    /* whole card is clickable */
    content: "";
    position: absolute;
    inset: 0;
  }
  p {
    margin: 0;
    font-size: 0.85rem;
  }
  .repo {
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .release {
    position: relative; /* above the card link */
    z-index: 1;
    padding-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }
  .release a {
    color: var(--fg);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .when {
    margin-left: auto;
    flex: none;
    color: var(--muted);
  }
</style>
