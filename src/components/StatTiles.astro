---
import { entryPath, PLATFORMS, platformLogo, platformMark, type PlatformId } from "../lib/data.ts";
import { stats, type Delta } from "../lib/stats.ts";
import CoverStack from "./CoverStack.astro";
import Spark from "./Spark.astro";

const { projects, platforms, fresh, updated } = stats;
const arrow = (d: Delta) => (d.diff > 0 ? "up" : d.diff < 0 ? "down" : "flat");
const signed = (n: number) => (n > 0 ? `+${n}` : String(n));
const { newest } = projects;
const newestMark = newest && platformMark(newest.platform);
const newestOwner = newest?.repo.split("/")[0];
const cal = updated.calendar;
const calMax = Math.max(1, ...cal.days.map((d) => d ?? 0));
const DAY_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
// Platform logos drift in three lanes; each lane holds its logos twice so the loop is seamless.
const lanes = [0, 1, 2].map((k) => platforms.ids.filter((_, i) => i % 3 === k));
const logoSize = (id: PlatformId) => {
  const l = platformLogo(id);
  if (!l) return undefined;
  // same visual area for every logo, so wordmarks and square marks weigh the same
  const h = Math.min(22, Math.sqrt(980 / l.aspect));
  return { src: l.src, w: +(h * l.aspect).toFixed(1), h: +h.toFixed(1) };
};
---

<div class="stats">
  <div class="tile">
    <div class="top">
      <span class="n">{projects.value}</span>
      <Spark values={projects.bars} label={projects.barsLabel} />
    </div>
    <span class="label">playable projects</span>
    {
      newest && (
        <div class="cmp newest" data-since={newest.firstReleaseAt}>
          <a class="nw-cover" href={entryPath(newest)} tabindex="-1" aria-hidden="true">
            {newest.cover ? <img src={newest.cover.src} width={newest.cover.width} height={newest.cover.height} alt="" loading="lazy" /> : <span class="ph" />}
          </a>
          <span class="nw-text">
            <span>
              newest: <a href={entryPath(newest)}>{newest.game}</a>
            </span>
            <span>
              first release <b class="since">{newest.firstReleaseAt!.slice(0, 10)}</b>
            </span>
            <span class="nw-platform">
              {newestMark ? (
                <img class="logo-img" src={newestMark.src} height="11" width={+(11 * newestMark.aspect).toFixed(1)} alt={PLATFORMS[newest.platform]} title={PLATFORMS[newest.platform]} />
              ) : (
                PLATFORMS[newest.platform]
              )}
            </span>
            <span>
              {newest.tool && <>{newest.tool} · </>}by <a href={`https://github.com/${newestOwner}`}>{newestOwner}</a>
            </span>
          </span>
        </div>
      )
    }
  </div>

  <div class="tile plat">
    <div class="drift">
      {
        lanes.map((ids, k) => (
          <div class={`lane l${k}`}>
            {[0, 1].map((copy) =>
              ids.map((id) => {
                const l = logoSize(id);
                return (
                  <span class="item" aria-hidden={copy ? "true" : undefined}>
                    {l ? (
                      <img class="logo-img" src={l.src} width={l.w} height={l.h} alt={copy ? "" : PLATFORMS[id]} title={PLATFORMS[id]} loading="lazy" />
                    ) : (
                      <span class="logo-text" title={PLATFORMS[id]}>
                        {PLATFORMS[id].split(" ")[0]}
                      </span>
                    )}
                  </span>
                );
              }),
            )}
          </div>
        ))
      }
    </div>
    <div class="plate">
      <span class="n">{platforms.value}</span>
      <span class="label">original platforms</span>
    </div>
  </div>

  <div class="tile">
    <div class="top">
      <span class="n glow">{fresh.value}</span>
      <Spark values={fresh.bars} label={fresh.barsLabel} />
    </div>
    <span class="label">new projects released this week</span>
    <span class={`cmp ${arrow(fresh.week)}`}>
      <b>{signed(fresh.week.diff)}</b> vs {fresh.week.before} the week before
    </span>
    <div class="covers"><CoverStack entries={fresh.entries} size={30} max={10} overlap={0.3} label="New projects this week" /></div>
  </div>

  <div class="tile">
    <div class="top">
      <span class="n">{updated.value}</span>
      <Spark values={updated.bars} label={updated.barsLabel} />
    </div>
    <span class="label">projects with releases this week</span>
    <span class={`cmp ${arrow(updated.week)}`}>
      <b>{signed(updated.week.diff)}</b> vs {updated.week.before} the week before
    </span>
    <div class="wk">
      <div class="wk-head mono">
        <span>
          week <b>{cal.number}</b>
        </span>
        <span>{cal.total.toLocaleString("en")} releases</span>
      </div>
      <ol class="wk-bars" aria-label={`Releases per day in week ${cal.number}`}>
        {
          cal.days.map((d, i) => (
            <li class={`day${i === cal.today ? " today" : ""}${d === null ? " future" : ""}`} title={d === null ? `${DAY_NAMES[i]}: still to come` : `${DAY_NAMES[i]}: ${d} releases${i === cal.today ? " so far" : ""}`}>
              <span class="cnt">{d ?? ""}</span>
              <span class="col">{d === null ? <span class="q">?</span> : <span class="bar" style={`height:${Math.max(4, (d / calMax) * 100)}%`} />}</span>
              <span class="dl">{DAY_NAMES[i]![0]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>

<script>
  // "newest: …, first release 1d 18:01:15 ago", ticking every second
  const pad = (n: number) => String(n).padStart(2, "0");
  for (const el of document.querySelectorAll<HTMLElement>("[data-since]")) {
    const t0 = Date.parse(el.dataset.since!);
    const out = el.querySelector(".since")!;
    const tick = () => {
      const s = Math.max(0, Math.floor((Date.now() - t0) / 1000));
      const d = Math.floor(s / 86400);
      out.textContent = `${d ? `${d}d ` : ""}${pad(Math.floor(s / 3600) % 24)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)} ago`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 2.2rem 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  @media (max-width: 860px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .tile {
    background: var(--surface);
    padding: 1rem 1.2rem 0.95rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 2.4rem;
  }
  .n {
    font-family: var(--mono);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .label {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .cmp {
    margin-top: 0.55rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--line);
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmp b {
    font-weight: 600;
    color: var(--muted);
  }
  .cmp.up b {
    color: var(--recomp);
  }
  .cmp.up b::before {
    content: "▲ ";
    font-size: 0.8em;
  }
  .cmp.down b {
    color: var(--accent);
  }
  .cmp.down b::before {
    content: "▼ ";
    font-size: 0.8em;
  }
  .covers {
    margin-top: 0.75rem;
  }
  /* fills the rest of the tile and centres in it, so the row's taller tiles leave no hole */
  .newest {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    white-space: normal;
    line-height: 1.8;
  }
  .nw-cover {
    flex: none;
    display: block;
  }
  .nw-cover img,
  .nw-cover .ph {
    display: block;
    width: 54px;
    height: 72px;
    object-fit: cover;
    border-radius: 3px;
    background: var(--surface-2);
    box-shadow: 0 4px 10px -4px rgb(0 0 0 / 0.9);
  }
  .nw-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .nw-text > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .newest a {
    color: var(--muted);
  }
  .newest a:hover {
    color: var(--fg);
  }
  .newest .since {
    display: block;
  }
  .nw-platform {
    display: flex;
    align-items: center;
    height: 1.8em;
  }
  .nw-platform img {
    opacity: 0.6;
  }
  /* Calendar week so far: a bar per day, "?" for the days still to come. */
  .wk {
    margin-top: 0.75rem;
    font-family: var(--mono);
  }
  .wk-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    color: var(--faint);
  }
  .wk-head b {
    color: var(--fg);
    font-weight: 600;
  }
  .wk-bars {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    height: 3rem;
    margin: 0.2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .day {
    display: grid;
    grid-template-rows: 10px minmax(0, 1fr) 12px;
    justify-items: center;
    min-height: 0;
    font-size: 0.5rem;
    color: var(--faint);
  }
  .col {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .bar {
    width: 100%;
    background: var(--muted);
    opacity: 0.45;
    border-radius: 2px 2px 0 0;
  }
  .q {
    font-size: 0.75rem;
    line-height: 1;
    opacity: 0.45;
  }
  .dl {
    align-self: end;
    font-size: 0.55rem;
  }
  .future .dl {
    opacity: 0.45;
  }
  .today {
    color: var(--recomp);
  }
  .today .bar {
    background: var(--recomp);
    opacity: 1;
  }
  .newest b {
    color: var(--recomp);
    font-variant-numeric: tabular-nums;
  }
  /* Platforms: logos drift sideways in three lanes under a plate with the count. */
  .plat {
    position: relative;
    overflow: hidden;
    padding: 0;
    min-height: 9.5rem;
  }
  .drift {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }
  .lane {
    display: flex;
    align-items: center;
    width: max-content;
    animation: drift 44s linear infinite;
  }
  .lane.l1 {
    animation-direction: reverse;
    animation-duration: 54s;
  }
  .lane.l2 {
    animation-duration: 49s;
  }
  .plat:hover .lane {
    animation-play-state: paused;
  }
  /* padding instead of gap: both copies are then exactly the same width, so -50% loops seamlessly */
  .item {
    display: flex;
    align-items: center;
    padding-right: 1.6rem;
  }
  .item img {
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  .item img:hover {
    opacity: 1;
  }
  @keyframes drift {
    to {
      translate: -50% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drift {
      inset: 0.6rem;
      flex-flow: row wrap;
      align-content: space-evenly;
      justify-content: center;
    }
    .lane {
      display: contents;
      animation: none;
    }
    .item {
      padding: 0 0.35rem;
    }
    .item img {
      width: auto;
      height: 0.8rem; /* width follows from the width/height attributes' aspect ratio */
    }
    .item[aria-hidden] {
      display: none;
    }
  }
  .plate {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.3rem 0.8rem 0.4rem;
    white-space: nowrap;
    background: rgb(18 22 36 / 0.9);
    border-radius: 10px;
    box-shadow: 0 0 16px 10px rgb(18 22 36 / 0.9);
    pointer-events: none;
  }
  .logo-text {
    font-family: var(--mono);
    font-size: 0.7rem;
    opacity: 0.6;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* narrower four-column rows: tuck the covers further in so the "+N" chip stays inside the tile */
  @media (max-width: 1240px) {
    .covers :global(.stack) {
      --o: 0.6 !important;
    }
  }
  /* phones: one tile per row, so each gets the full width */
  @media (max-width: 520px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .tile {
      padding: 0.85rem 1rem;
    }
    .covers :global(.stack) {
      --o: 0.3 !important;
    }
  }
</style>
