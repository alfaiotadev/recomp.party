---
// Large faint platform mark: the stand-in backdrop of a card without a cover.
import { fitLogoArea, platformMark, type Entry } from "../lib/data.ts";

interface Props {
  platform: Entry["platform"];
  scale?: number;
}
const { platform, scale = 2.6 } = Astro.props;
const mark = platformMark(platform);
const box = mark && fitLogoArea(mark, 900, 80, 16);
---

{mark && box && <img class="art-mark" src={mark.src} width={+(box.w * scale).toFixed(1)} height={+(box.h * scale).toFixed(1)} alt="" loading="lazy" />}

<style>
  .art-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -2;
    max-width: 70%;
    height: auto;
    translate: -50% -50%;
    filter: brightness(0) invert(1);
    opacity: 0.07;
    pointer-events: none;
  }
</style>
