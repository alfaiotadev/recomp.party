---
import { ago, entryPath, fitLogoArea, MILESTONE_KINDS, milestones, VENDORS, platformLogo, shortDate, type Entry, type PlatformId } from "../lib/data.ts";
import { aiFilterOptions, aiTokens } from "../lib/ai.ts";
import { VENDOR_ICONS } from "../lib/vendor-icons.ts";
import { AXIS_H, CHILD_INDENT, LABEL_W, layout, NAME_W, NAME_X, PAD_R, SORTS, views, W } from "../lib/timeline.ts";

interface Props {
  games: Entry[];
}
const { games } = Astro.props;
const layouts = views().map((v) => layout(games, v, milestones));
// AI co-author filter: each game's credited models and vendors (data/ai.json), for the browser
const aiMap = Object.fromEntries(games.map((g) => [g.repo, aiTokens(g)]).filter(([, t]) => t));
const dayMonth = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const defaultView = "1y";
// Platform filter (logo buttons on desktop, a select on phones): every platform with a lane in the widest range.
const lanePlatforms = layouts.at(-1)!.lanes.map((l) => {
  const logo = platformLogo(l.id as PlatformId);
  // same visual weight for wordmarks and square marks
  return { id: l.id, name: l.name, logo: logo && { src: logo.src, ...fitLogoArea(logo, 700, 84, 18) } };
});
---

<section class="timeline" aria-label="Release timeline by platform">
  {layouts.map((l) => <input type="radio" name="tl-view" id={`tl-${l.view.id}`} checked={l.view.id === defaultView} />)}
  <div class="tl-head">
    <div>
      <p class="eyebrow">Release timeline</p>
      <h2>One lane per original platform</h2>
    </div>
    <div class="tl-tabs" role="group" aria-label="Time range">
      {layouts.map((l) => (
        <label for={`tl-${l.view.id}`} title={l.view.label}>
          <span class="tab-long">{l.view.label}</span>
          <span class="tab-short">{l.view.short}</span>
        </label>
      ))}
    </div>
  </div>
  <p class="tl-legend">
    <span class="sw recomp"></span> static recompilation
    <span class="sw port"></span> source port
    <span class="sw pre"></span> pre-release
    {milestones.length > 0 && <><span class="sw mile"></span> milestone</>}
    {" "}<span class="legend-note">— each row runs from a project's first release to its latest one.</span>
  </p>
  <div class="d-plat-filter" role="group" aria-label="Platforms to show">
    <button type="button" class="all" data-plat="" aria-pressed="true">All</button>
    {lanePlatforms.map((p) => (
      <button type="button" data-plat={p.id} aria-pressed="false" title={p.name}>
        {p.logo ? <img class="logo-img" src={p.logo.src} width={+p.logo.w.toFixed(1)} height={+p.logo.h.toFixed(1)} alt={p.name} /> : p.name}
      </button>
    ))}
  </div>
  <label class="m-plat-filter">
    <span class="visually-hidden">Platform</span>
    <select aria-label="Platforms to show">
      <option value="">All platforms</option>
      <option value="*" hidden disabled>Several platforms</option>
      {lanePlatforms.map((p) => <option value={p.id}>{p.name}</option>)}
    </select>
  </label>
  <label class="tl-ai">
    <span>AI co-author</span>
    <select aria-label="Show only projects whose commits credit this model or agent" data-map={JSON.stringify(aiMap)}>
      <option value="">Any</option>
      {aiFilterOptions.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </label>
  <p class="m-empty" hidden>No releases for this platform in this range.</p>
  <div class="tl-views">
    {
      layouts.map((l) => {
        // Only the default range's desktop chart is live; the rest wait in <template>s until shown.
        const Desktop = l.view.id === defaultView ? "div" : "template";
        return (
        <div class="tl-view" data-view={l.view.id} data-top={l.top} data-plan={JSON.stringify(l.plan)} data-axis={l.view.id === "1d" ? JSON.stringify({ start: l.view.start, end: l.view.end, l: NAME_X + NAME_W, r: W - PAD_R }) : undefined}>
          {l.view.id === "1d" && <p class="today-none" hidden>No releases yet today.</p>}
          <Desktop class="part" data-part="desktop">
          <div class="tl-inner">
          <div class="tl-fold" hidden style={`left:0.75%;width:${(LABEL_W / W) * 100}%;top:${(l.top / l.initial.height) * 100}%;height:${(AXIS_H / l.initial.height) * 100}%`}>
            <button type="button" class="fold-all" aria-label="Expand every game with several projects">
              <span class="fold-chev" aria-hidden="true" />
              <span class="fold-text">expand all</span>
            </button>
          </div>
          <label class="tl-sort" hidden style={`left:${(NAME_X / W) * 100}%;width:${(NAME_W / W) * 100}%;top:${(l.top / l.initial.height) * 100}%;height:${(AXIS_H / l.initial.height) * 100}%`}>
            <span>sort</span>
            <select aria-label="Sort projects within each platform">
              {SORTS.map((s) => <option value={s.id}>{s.label}</option>)}
            </select>
          </label>
          <svg viewBox={`0 0 ${W} ${l.initial.height}`} role="img" aria-label={`${l.view.label}: releases per platform`}>
            {l.lanes.map((lane, i) => (
              <g class="lane" style={`transform:translateY(${l.initial.lanes[i]!.y}px)`}>
                <rect class={i % 2 ? "lane-bg odd" : "lane-bg"} x="0" y="0" width={W} height={l.initial.lanes[i]!.height} />
                {lane.logo ? (
                  <image class="logo-img" href={lane.logo.src} x="12" y={10 + (24 - lane.logo.h) / 2} width={lane.logo.w} height={lane.logo.h}>
                    <title>{lane.name}</title>
                  </image>
                ) : (
                  <text class="lane-name" x="12" y="28">
                    {lane.name}
                  </text>
                )}
                <text class="lane-count" x="12" y="48">
                  {lane.count} {lane.count === 1 ? "project" : "projects"}
                </text>
              </g>
            ))}
            {l.ticks.map((t) => (
              <g class={t.major ? "tick major" : "tick"}>
                <line class="to-bottom" x1={t.x} x2={t.x} y1={l.top + AXIS_H - 4} y2={l.initial.height} />
                <text x={t.x + 3} y={l.top + AXIS_H - 8}>
                  {t.label}
                </text>
              </g>
            ))}
            <line class="now to-bottom" x1={l.nowX} x2={l.nowX} y1={l.top + AXIS_H - 4} y2={l.initial.height} />
            {l.top > 0 && (
              <a class="mile-head" href="/m/">
                <text x="12" y={l.top - 7}>Notable events</text>
              </a>
            )}
            {l.marks.map((mk) => {
              const ly = l.top - 11; // logo centre, on the line just above the axis
              const ty = mk.row === 1 ? 14 : 30; // first line's baseline: row 0 sits on the logo; a second line goes below
              const hit = mk.row === null ? { x: mk.x - 9, w: 18 } : { x: Math.min(mk.cx - mk.w / 2, mk.x - 9) - 3, w: Math.max(mk.cx + mk.w / 2, mk.x + 9) - Math.min(mk.cx - mk.w / 2, mk.x - 9) + 6 };
              return (
                <a class={`mile v-${mk.m.vendor}`} href={mk.href} aria-label={`${MILESTONE_KINDS[mk.m.kind]}, ${shortDate(mk.m.date)}: ${mk.m.title}`} data-mile={`${MILESTONE_KINDS[mk.m.kind]} · ${VENDORS[mk.m.vendor]}`} data-vendor={mk.m.vendor} data-title={mk.m.title} data-date={shortDate(mk.m.date)}>
                  <line class="mile-line to-bottom" x1={mk.x} x2={mk.x} y1={ly + 7} y2={l.initial.height} />
                  <rect class="mile-hit" x={hit.x} y="0" width={hit.w} height={l.top} rx="4" />
                  <circle class="mile-disc" cx={mk.x} cy={ly} r="8" />
                  <path class="mile-logo" d={VENDOR_ICONS[mk.m.vendor]} transform={`translate(${mk.x - 5.5} ${ly - 5.5}) scale(${11 / 24})`} />
                  {mk.row !== null && (
                    <>
                      <text class="mile-label" x={mk.cx} y={ty}>{mk.lines[0]}</text>
                      {mk.lines[1] && <text class={mk.m.sub ? "mile-sub" : "mile-label"} x={mk.cx} y={ty + 16}>{mk.lines[1]}</text>}
                    </>
                  )}
                </a>
              );
            })}
            {l.lanes.flatMap((lane, i) =>
              lane.items.flatMap((it) => {
                const r = it.row;
                const odd = i % 2 ? " odd" : "";
                const marks = (row: typeof r, x0: number) => (
                  <>
                    <rect class="hit" x="0" y="-9" width={W} height="18" />
                    {row.guide && <line class="guide" x1={row.guide.x1} x2={row.guide.x2} y1="0" y2="0" />}
                    <line class="bar" x1={row.x1} x2={row.x2} y1="0" y2="0" />
                    {row.clipped && <path class="bar-clip" d={`M${row.x1 + 6} -4 L${row.x1} 0 L${row.x1 + 6} 4`} />}
                    {row.dots.map((d) => (
                      <circle class={`dot k-${d.kind}${d.prerelease ? " pre" : ""}`} cx={d.x} cy="0" r="3.2" />
                    ))}
                    <text class={x0 > NAME_X ? "label repo-label" : "label"} x={x0} y="4">
                      {row.name}
                    </text>
                  </>
                );
                if (!it.children) {
                  return [
                    <a href={r.href} class={`row ${r.entry.kind}${odd}`} data-id={r.id} style={`transform:translateY(${l.initial.y[r.id]}px)`} aria-label={`${r.entry.game} (${r.entry.repo})`} data-game={r.entry.game} data-repo={r.entry.repo} data-kind={r.entry.kind} data-first={shortDate(r.entry.firstReleaseAt!)} data-latest={shortDate(r.entry.latestReleaseAt!)} data-count={r.entry.snap?.releaseCount ?? 0} data-stars={(r.entry.snap?.stars ?? 0).toLocaleString("en")} data-tool={r.entry.tool ?? ""} data-cover={r.entry.cover?.src ?? ""}>
                      {marks(r, NAME_X)}
                    </a>,
                  ];
                }
                const g = it.group!;
                const badgeX = NAME_X + r.name.length * 6.1 + 7;
                return [
                  ...it.children.map((c) => (
                    <a href={c.href} class={`row child shut ${c.entry.kind}${odd}`} data-id={c.id} data-parent={r.id} tabindex="-1" aria-hidden="true" style={`transform:translateY(${l.initial.y[c.id]}px)`} aria-label={`${c.entry.game} (${c.entry.repo})`} data-game={c.entry.game} data-repo={c.entry.repo} data-kind={c.entry.kind} data-first={shortDate(c.entry.firstReleaseAt!)} data-latest={shortDate(c.entry.latestReleaseAt!)} data-count={c.entry.snap?.releaseCount ?? 0} data-stars={(c.entry.snap?.stars ?? 0).toLocaleString("en")} data-tool={c.entry.tool ?? ""} data-cover={c.entry.cover?.src ?? ""}>
                      {marks(c, NAME_X + CHILD_INDENT)}
                    </a>
                  )),
                  <g class={`row group ${g.kind}${odd}`} data-id={r.id} role="button" tabindex="0" aria-expanded="false" aria-label={`${r.name}: ${g.count} projects, show them`} style={`transform:translateY(${l.initial.y[r.id]}px)`} data-group={g.count} data-game={r.name} data-kind={g.kind} data-kinds={it.children.map((c) => c.entry.kind).join(" ")} data-first={shortDate(g.first)} data-latest={shortDate(g.latest)} data-count={g.releases} data-stars={g.stars.toLocaleString("en")} data-cover={g.cover ?? ""}>
                    {marks(r, NAME_X)}
                    <path class="chev" d={`M${NAME_X - 13} -3 L${NAME_X - 9} 1 L${NAME_X - 5} -3`} />
                    <rect class="badge-bg" x={badgeX} y="-6.5" width={g.count > 9 ? 22 : 17} height="13" rx="6.5" />
                    <text class="badge-n" x={badgeX + (g.count > 9 ? 11 : 8.5)} y="3.5">
                      ×{g.count}
                    </text>
                  </g>,
                ];
              }),
            )}
          </svg>
          </div>
          </Desktop>
          <template class="part" data-part="mobile">
          <div class="tl-m">
            <div class="m-bar-top">
              <div class="tl-fold m-fold" hidden>
                <button type="button" class="fold-all" aria-label="Expand every game with several projects">
                  <span class="fold-chev" aria-hidden="true" />
                  <span class="fold-text">expand all</span>
                </button>
              </div>
              <label class="tl-sort m-sort" hidden>
                <span>sort</span>
                <select aria-label="Sort projects within each platform">
                  {SORTS.map((s) => <option value={s.id}>{s.label}</option>)}
                </select>
              </label>
            </div>
            {l.marks.length > 0 && (
              <div class="m-miles">
                <a class="m-miles-head" href="/m/">Notable events</a>
                <div class="m-mile-track">
                  {l.marks.map((mk, k) => (
                    <button type="button" class={`m-mile-btn v-${mk.m.vendor}`} style={`left:${l.mobile.miles[k]}%`} aria-expanded="false" aria-label={`${dayMonth(mk.m.date)}: ${mk.m.title}`} data-href={mk.href} data-date={dayMonth(mk.m.date)} data-label={mk.m.sub ? `${mk.m.label} · ${mk.m.sub}` : mk.m.label}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={VENDOR_ICONS[mk.m.vendor]} /></svg>
                    </button>
                  ))}
                </div>
                <p class="m-mile-cap" hidden></p>
              </div>
            )}
            {l.lanes.map((lane) => (
              <div class="m-lane" data-platform={lane.id}>
                <div class="m-head">
                  <div class="m-plat">
                    {lane.logo ? <img class="logo-img" src={lane.logo.src} width={lane.logo.w * 0.85} height={lane.logo.h * 0.85} alt={lane.name} /> : <strong>{lane.name}</strong>}
                    <span class="m-count">{lane.count} {lane.count === 1 ? "project" : "projects"}</span>
                  </div>
                  <div class="m-axis" aria-hidden="true">
                    {l.mobile.ticks.filter((tk, k) => tk.major || l.view.ticks === "year" || k % 2 === 0).map((tk) => (
                      <span style={`left:${tk.p}%`}>{tk.label.replace(/ \d{4}$/, "")}</span>
                    ))}
                  </div>
                </div>
                <ol class="m-rows">
                  <li class="m-grid" aria-hidden="true">
                    {l.mobile.ticks.map((tk) => <span class={tk.major ? "major" : ""} style={`left:${tk.p}%`} />)}
                    <span class="m-now" style={`left:${l.mobile.now}%`} />
                    {l.marks.map((mk) => <span class={`m-mile v-${mk.m.vendor}`} style={`left:${mk.p}%`} />)}
                  </li>
                  {lane.items.map((it) => {
                    const r = it.row;
                    const mtrack = (row: typeof r) => (
                      <span class="m-track">
                        {row.clipped && <span class="m-clip" />}
                        <span class="m-bar" style={`left:${row.pct.x1}%;width:${Math.max(0, row.pct.x2 - row.pct.x1)}%`} />
                        {row.pct.dots.map((d) => (
                          <span class={`m-dot k-${d.kind}${d.prerelease ? " pre" : ""}`} style={`left:${d.x}%`} />
                        ))}
                      </span>
                    );
                    if (!it.children) {
                      return (
                        <li class={`m-row ${r.entry.kind}`} style={`order:${r.ranks.first! + 1}`} data-ranks={JSON.stringify(r.ranks)} data-repo={r.entry.repo}>
                          <a href={entryPath(r.entry)}>
                            <span class="m-name">{r.entry.game}</span>
                            <span class="m-when">{ago(r.entry.latestReleaseAt)}</span>
                            {mtrack(r)}
                          </a>
                        </li>
                      );
                    }
                    const g = it.group!;
                    return (
                      <li class={`m-row m-group ${g.kind}`} style={`order:${r.ranks.first! + 1}`} data-ranks={JSON.stringify(r.ranks)} data-id={r.id}>
                        <button type="button" class="m-toggle" aria-expanded="false">
                          <span class="m-name">
                            <span class="m-chev" aria-hidden="true" />
                            {r.name} <span class="m-badge">×{g.count}</span>
                          </span>
                          <span class="m-when">{ago(g.latest)}</span>
                          {mtrack(r)}
                        </button>
                        <ol class="m-children" hidden>
                          {it.children.map((c) => (
                            <li class={`m-row m-child ${c.entry.kind}`} style={`order:${c.ranks.first! + 1}`} data-ranks={JSON.stringify(c.ranks)} data-repo={c.entry.repo}>
                              <a href={entryPath(c.entry)}>
                                <span class="m-name m-repo">{c.entry.repo}</span>
                                <span class="m-when">{ago(c.entry.latestReleaseAt)}</span>
                                {mtrack(c)}
                              </a>
                            </li>
                          ))}
                        </ol>
                      </li>
                    );
                  })}
                </ol>
              </div>
            ))}
          </div>
          </template>
        </div>
        );
      })
    }
  </div>
  <div class="tl-tip" id="tl-tip" role="tooltip" hidden></div>
</section>

<script>
  import { place, AXIS_H, type PlaceLane } from "../lib/timeline-place.ts";

  const root = document.querySelector<HTMLElement>(".timeline");
  if (root) {
    const views = [...root.querySelectorAll<HTMLElement>(".tl-view")];
    const phone = matchMedia("(max-width: 760px)");
    const open = new Set<string>(); // group row ids, shared by all three time ranges
    let sort = "first";
    try {
      const saved = localStorage.getItem("tl-sort");
      if (saved) sort = saved;
    } catch {}
    const allGroups = new Set(views.flatMap((v) => (JSON.parse(v.dataset.plan!) as PlaceLane[]).flatMap((l) => l.items.filter((i) => i.children).map((i) => i.id))));

    // "Today" is the visitor's own calendar day. The build renders the last 24 hours, which always
    // contains the visitor's last midnight; here every time position in that range is mapped onto
    // local 00:00–24:00 and whatever came before midnight is dropped.
    const todayHidden = new Map<HTMLElement, Set<string>>(); // view → row ids with nothing today
    const SVG = "http://www.w3.org/2000/svg";
    // Elements made here need the component's scoped-style attribute (data-astro-cid-…) to pick up its CSS.
    const cid = [...root.attributes].find((at) => at.name.startsWith("data-astro-cid-"))?.name;
    const scoped = <T extends Element>(el: T): T => {
      if (cid) el.setAttribute(cid, "");
      for (const c of el.children) scoped(c);
      return el;
    };
    const retimeToday = (view: HTMLElement, part: "desktop" | "mobile") => {
      const a = JSON.parse(view.dataset.axis!) as { start: number; end: number; l: number; r: number };
      const day0 = new Date();
      day0.setHours(0, 0, 0, 0);
      const day1 = new Date(day0);
      day1.setDate(day1.getDate() + 1);
      const s = day0.getTime(), e = day1.getTime();
      const span = a.r - a.l;
      const tOfX = (x: number) => a.start + ((x - a.l) / span) * (a.end - a.start);
      const xOfT = (t: number) => a.l + ((t - s) / (e - s)) * span;
      const tOfP = (p: number) => a.start + (p / 100) * (a.end - a.start);
      const pOfT = (t: number) => +(((t - s) / (e - s)) * 100).toFixed(2);
      const ticks: { t: number; label: string; major: boolean }[] = [];
      for (const d = new Date(day0); d.getTime() < e; d.setHours(d.getHours() + 3)) {
        const h = d.getHours();
        ticks.push({ t: d.getTime(), label: h === 0 ? d.toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : `${String(h).padStart(2, "0")}:00`, major: h === 0 });
      }
      const hidden = todayHidden.get(view) ?? new Set<string>();
      todayHidden.set(view, hidden);
      let shown = 0;

      if (part === "desktop") {
        const svg = view.querySelector("svg")!;
        for (const row of svg.querySelectorAll<SVGElement>(".row[data-id]")) {
          const bar = row.querySelector(".bar")!;
          const t1 = tOfX(+bar.getAttribute("x1")!), t2 = tOfX(+bar.getAttribute("x2")!);
          if (t2 < s) {
            hidden.add(row.dataset.id!);
            continue;
          }
          if (!row.classList.contains("group")) shown++;
          const x1 = Math.max(a.l, xOfT(t1));
          bar.setAttribute("x1", String(x1));
          bar.setAttribute("x2", String(xOfT(t2)));
          for (const dot of row.querySelectorAll("circle.dot")) {
            const t = tOfX(+dot.getAttribute("cx")!);
            if (t < s) dot.remove();
            else dot.setAttribute("cx", String(xOfT(t)));
          }
          row.querySelector(".bar-clip")?.remove();
          if (t1 < s) {
            const clip = document.createElementNS(SVG, "path");
            clip.setAttribute("class", "bar-clip");
            clip.setAttribute("d", `M${x1 + 6} -4 L${x1} 0 L${x1 + 6} 4`);
            bar.after(scoped(clip));
          }
          const guide = row.querySelector(".guide");
          if (guide && x1 - 6 - +guide.getAttribute("x1")! > 10) guide.setAttribute("x2", String(x1 - 6));
          else guide?.remove();
        }
        svg.querySelectorAll(".tick").forEach((t) => t.remove());
        const now = svg.querySelector(".now")!;
        for (const tk of ticks) {
          const g = document.createElementNS(SVG, "g");
          g.setAttribute("class", tk.major ? "tick major" : "tick");
          const x = xOfT(tk.t);
          const line = document.createElementNS(SVG, "line");
          line.setAttribute("class", "to-bottom");
          for (const [k, v] of Object.entries({ x1: x, x2: x, y1: AXIS_H - 4, y2: svg.viewBox.baseVal.height })) line.setAttribute(k, String(v));
          const text = document.createElementNS(SVG, "text");
          text.setAttribute("x", String(x + 3));
          text.setAttribute("y", String(AXIS_H - 8));
          text.textContent = tk.label;
          g.append(line, text);
          now.before(scoped(g));
        }
        now.setAttribute("x1", String(xOfT(Date.now())));
        now.setAttribute("x2", String(xOfT(Date.now())));
        // per-lane project counts for the day
        const plan = JSON.parse(view.dataset.plan!) as PlaceLane[];
        view.querySelectorAll<SVGGElement>(".lane").forEach((g, i) => {
          const n = plan[i]!.items.reduce((sum, it) => sum + (it.children ? it.children.filter((c) => !hidden.has(c.id)).length : hidden.has(it.id) ? 0 : 1), 0);
          g.querySelector(".lane-count")!.textContent = `${n} ${n === 1 ? "project" : "projects"}`;
        });
      } else {
        const m = view.querySelector<HTMLElement>(".tl-m")!;
        for (const li of m.querySelectorAll<HTMLElement>(".m-row")) {
          const track = li.querySelector<HTMLElement>(":scope > a > .m-track, :scope > button > .m-track")!;
          const bar = track.querySelector<HTMLElement>(".m-bar")!;
          const p1 = parseFloat(bar.style.left), p2 = p1 + parseFloat(bar.style.width);
          const t1 = tOfP(p1), t2 = tOfP(p2);
          if (t2 < s) {
            li.classList.add("not-today");
            continue;
          }
          if (!li.classList.contains("m-group")) shown++;
          const q1 = Math.max(0, pOfT(t1));
          bar.style.left = `${q1}%`;
          bar.style.width = `${Math.max(0, pOfT(t2) - q1)}%`;
          for (const dot of track.querySelectorAll<HTMLElement>(".m-dot")) {
            const t = tOfP(parseFloat(dot.style.left));
            if (t < s) dot.remove();
            else dot.style.left = `${pOfT(t)}%`;
          }
          const clip = track.querySelector(".m-clip");
          if (t1 >= s) clip?.remove();
          else if (!clip) track.prepend(scoped(Object.assign(document.createElement("span"), { className: "m-clip" })));
        }
        for (const lane of m.querySelectorAll<HTMLElement>(".m-lane")) {
          const n = lane.querySelectorAll(".m-row:not(.m-group):not(.not-today)").length;
          lane.classList.toggle("not-today", n === 0);
          lane.querySelector(".m-count")!.textContent = `${n} ${n === 1 ? "project" : "projects"}`;
          const axis = lane.querySelector(".m-axis")!;
          axis.replaceChildren(...ticks.filter((tk, k) => tk.major || k % 2 === 0).map((tk) => scoped(Object.assign(document.createElement("span"), { textContent: tk.label, style: `left:${pOfT(tk.t)}%` }))));
          const grid = lane.querySelector(".m-grid")!;
          grid.replaceChildren(
            ...ticks.map((tk) => scoped(Object.assign(document.createElement("span"), { className: tk.major ? "major" : "", style: `left:${pOfT(tk.t)}%` }))),
            scoped(Object.assign(document.createElement("span"), { className: "m-now", style: `left:${pOfT(Date.now())}%` })),
          );
        }
      }
      view.querySelector<HTMLElement>(".today-none")!.hidden = shown > 0;
    };

    // Desktop: rerun the placement and move rows, lanes, grid lines and the controls to match.
    const layoutDesktop = (view: HTMLElement) => {
      const svg = view.querySelector("svg");
      if (!svg) return;
      const plan = JSON.parse(view.dataset.plan!) as PlaceLane[];
      const off = todayHidden.get(view);
      // rows out of the view: nothing today, or not matching the AI co-author filter (a group goes with its last project)
      const drop = (id: string) => !!off?.has(id) || !aiOk(id);
      const visible = plan
        .map((l) => ({
          ...l,
          items: l.items
            .filter((it) => (it.children ? !off?.has(it.id) : !drop(it.id)))
            .map((it) => (it.children ? { ...it, children: it.children.filter((c) => !drop(c.id)) } : it))
            .filter((it) => !it.children || it.children.length),
        }))
        .filter((l) => l.items.length);
      const shown = visible.filter((l) => !plats.size || plats.has(l.id!));
      const top = +(view.dataset.top ?? 0);
      const p = place(shown, sort, (id) => open.has(id), top);
      svg.setAttribute("viewBox", `0 0 ${svg.viewBox.baseVal.width} ${p.height}`);
      view.querySelectorAll<SVGGElement>(".lane").forEach((g, i) => {
        const k = shown.findIndex((l) => l.id === plan[i]!.id);
        g.style.display = k < 0 ? "none" : "";
        if (k < 0) return;
        g.style.transform = `translateY(${p.lanes[k]!.y}px)`;
        const n = shown[k]!.items.reduce((sum, it) => sum + (it.children?.length ?? 1), 0);
        g.querySelector(".lane-count")!.textContent = `${n} ${n === 1 ? "project" : "projects"}`;
        g.querySelector("rect")!.setAttribute("height", String(p.lanes[k]!.height));
      });
      for (const line of view.querySelectorAll(".to-bottom")) line.setAttribute("y2", String(p.height));
      for (const el of view.querySelectorAll<HTMLElement>(".tl-inner > .tl-sort, .tl-inner > .tl-fold")) {
        el.style.top = `${(top / p.height) * 100}%`;
        el.style.height = `${(AXIS_H / p.height) * 100}%`;
      }
      for (const row of svg.querySelectorAll<SVGElement>(".row[data-id]")) {
        const id = row.dataset.id!;
        row.style.display = p.y[id] === undefined ? "none" : "";
        if (p.y[id] === undefined) continue;
        row.style.transform = `translateY(${p.y[id]}px)`;
        if (row.classList.contains("child")) {
          const shut = p.hidden.has(id);
          row.classList.toggle("shut", shut);
          row.setAttribute("tabindex", shut ? "-1" : "0");
          row.setAttribute("aria-hidden", String(shut));
        } else if (row.classList.contains("group")) {
          const isOpen = open.has(id);
          row.classList.toggle("open", isOpen);
          row.setAttribute("aria-expanded", String(isOpen));
          row.setAttribute("aria-label", row.getAttribute("aria-label")!.replace(/, (show|hide) them$/, isOpen ? ", hide them" : ", show them"));
        }
      }
    };
    // Phone: CSS order follows the sort, groups open their own list.
    const layoutMobile = (view: HTMLElement) => {
      for (const li of view.querySelectorAll<HTMLElement>(".m-row")) li.style.order = String(JSON.parse(li.dataset.ranks!)[sort] + 1);
      for (const li of view.querySelectorAll<HTMLElement>(".m-group")) {
        const isOpen = open.has(li.dataset.id!);
        li.classList.toggle("open", isOpen);
        li.querySelector(".m-toggle")!.setAttribute("aria-expanded", String(isOpen));
        li.querySelector<HTMLElement>(".m-children")!.hidden = !isOpen;
      }
    };
    const syncControls = () => {
      const allOpen = allGroups.size > 0 && [...allGroups].every((id) => open.has(id));
      for (const b of root.querySelectorAll<HTMLButtonElement>(".fold-all")) {
        b.closest<HTMLElement>(".tl-fold")!.hidden = allGroups.size === 0;
        b.classList.toggle("open", allOpen);
        b.querySelector(".fold-text")!.textContent = allOpen ? "collapse all" : "expand all";
        b.setAttribute("aria-label", allOpen ? "Collapse every game group" : "Expand every game with several projects");
      }
      for (const sel of root.querySelectorAll<HTMLSelectElement>(".tl-sort select")) {
        if (sel.querySelector(`option[value="${sort}"]`)) sel.value = sort;
        sel.closest<HTMLElement>(".tl-sort")!.hidden = false;
      }
    };
    // Platforms to show (none picked = all) in every range, including ones materialized later: toggling
    // logo buttons on desktop, a one-platform select on phones, one shared choice.
    const platSelect = root.querySelector<HTMLSelectElement>(".m-plat-filter select")!;
    const platButtons = [...root.querySelectorAll<HTMLButtonElement>(".d-plat-filter button")];
    const empty = root.querySelector<HTMLElement>(".m-empty")!;
    let plats = new Set<string>();
    const filterLanes = () => {
      // phones: the AI co-author filter hides rows, then groups and lanes left empty
      for (const li of root.querySelectorAll<HTMLElement>(".m-row[data-repo]")) li.classList.toggle("not-ai", !aiOk(li.dataset.repo!));
      for (const li of root.querySelectorAll<HTMLElement>(".m-group")) li.classList.toggle("not-ai", !li.querySelector(".m-child:not(.not-ai):not(.not-today)"));
      for (const lane of root.querySelectorAll<HTMLElement>(".m-lane")) {
        const n = lane.querySelectorAll(".m-row:not(.m-group):not(.not-today):not(.not-ai)").length;
        lane.classList.toggle("not-ai", n === 0 && !lane.classList.contains("not-today"));
        lane.querySelector(".m-count")!.textContent = `${n} ${n === 1 ? "project" : "projects"}`;
      }
      for (const lane of root.querySelectorAll<HTMLElement>(".m-lane")) lane.hidden = plats.size > 0 && !plats.has(lane.dataset.platform!);
      const lanes = JSON.parse(current().dataset.plan!) as PlaceLane[];
      empty.hidden = !plats.size || lanes.some((l) => plats.has(l.id!));
    };
    const aiSelect = root.querySelector<HTMLSelectElement>(".tl-ai select")!;
    const aiMap = JSON.parse(aiSelect.dataset.map!) as Record<string, string>;
    let aiSel = "";
    /** Project row ids are repos; group rows ("g:…") are kept or dropped with their projects. */
    const aiOk = (id: string) => !aiSel || id.startsWith("g:") || (aiMap[id] ?? "").split(" ").includes(aiSel);
    aiSelect.addEventListener("change", () => {
      aiSel = aiSelect.value;
      root.classList.add("no-anim");
      for (const v of views) layoutDesktop(v);
      filterLanes();
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("no-anim")));
    });
    const setPlats = (next: Set<string>) => {
      plats = next;
      platSelect.value = plats.size === 0 ? "" : plats.size === 1 ? [...plats][0]! : "*";
      for (const b of platButtons) b.setAttribute("aria-pressed", String(b.dataset.plat ? plats.has(b.dataset.plat) : plats.size === 0));
      root.classList.add("no-anim");
      for (const v of views) layoutDesktop(v);
      filterLanes();
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("no-anim")));
      try {
        localStorage.setItem("tl-plat", JSON.stringify([...plats]));
      } catch {}
    };
    platSelect.addEventListener("change", () => setPlats(new Set(platSelect.value ? [platSelect.value] : [])));
    for (const b of platButtons)
      b.addEventListener("click", () => {
        const id = b.dataset.plat;
        if (!id) return setPlats(new Set()); // "All" resets
        const next = new Set(plats);
        if (!next.delete(id)) next.add(id);
        setPlats(next);
      });
    const relayout = () => {
      for (const v of views) {
        layoutDesktop(v);
        layoutMobile(v);
      }
      syncControls();
    };

    // Lazy parts: a range's chart (or its phone list) leaves its <template> the first time it is shown.
    const current = () => views.find((v) => (root.querySelector<HTMLInputElement>(`#tl-${v.dataset.view}`)!).checked) ?? views[0]!;
    const materialize = () => {
      const view = current();
      const tpl = view.querySelector<HTMLTemplateElement>(`template[data-part="${phone.matches ? "mobile" : "desktop"}"]`);
      if (!tpl) return filterLanes();
      tpl.replaceWith(tpl.content);
      if (view.dataset.axis) retimeToday(view, phone.matches ? "mobile" : "desktop");
      root.classList.add("no-anim");
      layoutDesktop(view);
      layoutMobile(view);
      syncControls();
      filterLanes();
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("no-anim")));
    };
    for (const radio of root.querySelectorAll<HTMLInputElement>('input[name="tl-view"]')) radio.addEventListener("change", materialize);
    phone.addEventListener("change", materialize);
    materialize();
    try {
      // an array of platform ids (older visits stored one id as a plain string)
      const saved = localStorage.getItem("tl-plat");
      const ids: string[] = saved?.startsWith("[") ? JSON.parse(saved) : saved ? [saved] : [];
      const known = ids.filter((id) => platButtons.some((b) => b.dataset.plat === id));
      if (known.length) setPlats(new Set(known));
    } catch {}
    if (sort !== "first") {
      root.classList.add("no-anim");
      relayout();
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("no-anim")));
    } else syncControls();

    const toggle = (id: string) => {
      if (open.has(id)) open.delete(id);
      else open.add(id);
      relayout();
    };
    // One set of listeners for every row, including the ones materialized later.
    root.addEventListener("click", (e) => {
      const t = e.target as Element;
      const group = t.closest<SVGGElement>(".row.group");
      if (group) return toggle(group.dataset.id!);
      const mile = t.closest<HTMLButtonElement>(".m-mile-btn");
      if (mile) {
        const box = mile.closest(".m-miles")!;
        const cap = box.querySelector<HTMLElement>(".m-mile-cap")!;
        const wasOpen = mile.getAttribute("aria-expanded") === "true";
        for (const b of box.querySelectorAll(".m-mile-btn")) b.setAttribute("aria-expanded", "false");
        cap.hidden = wasOpen;
        if (wasOpen) return;
        mile.setAttribute("aria-expanded", "true");
        const d = mile.dataset;
        const date = Object.assign(document.createElement("span"), { className: "m-mile-date", textContent: d.date });
        const link = Object.assign(document.createElement("a"), { href: d.href, textContent: "details →" });
        cap.className = `m-mile-cap ${[...mile.classList].find((c) => c.startsWith("v-"))}`;
        cap.replaceChildren(scoped(date), ` ${d.label} `, scoped(link));
        return;
      }
      const mToggle = t.closest(".m-toggle");
      if (mToggle) return toggle(mToggle.closest<HTMLElement>(".m-group")!.dataset.id!);
      if (t.closest(".fold-all")) {
        const allOpen = [...allGroups].every((id) => open.has(id));
        open.clear();
        if (!allOpen) for (const id of allGroups) open.add(id);
        relayout();
      }
    });
    root.addEventListener("keydown", (e) => {
      const group = (e.target as Element).closest?.<SVGGElement>(".row.group");
      if (group && (e.key === "Enter" || e.key === " ")) {
        e.preventDefault();
        toggle(group.dataset.id!);
      }
    });
    root.addEventListener("change", (e) => {
      const sel = (e.target as Element).closest?.<HTMLSelectElement>(".tl-sort select");
      if (!sel) return;
      sort = sel.value;
      relayout();
      try {
        localStorage.setItem("tl-sort", sort);
      } catch {}
    });

    // --- tooltip (delegated: follows whichever row the pointer or focus is on)
    const tip = document.getElementById("tl-tip")!;
    const kinds: Record<string, string> = { recomp: "Static recompilation", port: "Source port" };
    const line = (cls: string, text: string) => {
      const el = document.createElement("div");
      el.className = cls;
      el.textContent = text;
      return el;
    };
    const fill = (d: DOMStringMap) => {
      const text = document.createElement("div");
      if (d.mile) {
        text.append(line(`t-kind v-${d.vendor}`, d.mile), line("t-game", d.title!), line("t-meta", d.date!), line("t-repo", "click for details"));
      } else if (d.group) {
        const kindsIn = d.kinds!.split(" ");
        const recomps = kindsIn.filter((k) => k === "recomp").length;
        const ports = kindsIn.length - recomps;
        const mix = [recomps && `${recomps} recomp${recomps > 1 ? "s" : ""}`, ports && `${ports} port${ports > 1 ? "s" : ""}`].filter(Boolean).join(" · ");
        text.append(
          line(`t-kind ${d.kind}`, `${d.group} projects · ${mix}`),
          line("t-game", d.game!),
          line("t-repo", "click to list them"),
          line("t-meta", `${d.first} → ${d.latest}`),
          line("t-meta", `${d.count} releases · ★ ${d.stars}`),
        );
      } else {
        text.append(
          line(`t-kind ${d.kind}`, kinds[d.kind!] + (d.tool ? " · " + d.tool : "")),
          line("t-game", d.game!),
          line("t-repo", d.repo!),
          line("t-meta", `${d.first} → ${d.latest}`),
          line("t-meta", `${d.count} releases · ★ ${d.stars}`),
        );
      }
      if (d.cover) {
        const img = document.createElement("img");
        img.className = "t-cover";
        img.src = d.cover;
        img.alt = "";
        tip.replaceChildren(img, text);
      } else tip.replaceChildren(text);
      tip.classList.toggle("has-cover", !!d.cover);
      tip.classList.toggle("is-mile", !!d.mile);
      tip.hidden = false;
    };
    const placeTip = (x: number, y: number) => {
      const pad = 14,
        w = tip.offsetWidth,
        h = tip.offsetHeight;
      const left = x + pad + w > innerWidth - 8 ? x - pad - w : x + pad;
      const top = y + pad + h > innerHeight - 8 ? y - pad - h : y + pad;
      tip.style.transform = `translate(${Math.max(8, left)}px, ${Math.max(8, top)}px)`;
    };
    let hovered: Element | null = null;
    const rowOf = (t: EventTarget | null) => (t as Element | null)?.closest?.("svg .row, svg .mile") ?? null;
    root.addEventListener("pointerover", (e) => {
      const row = rowOf(e.target);
      if (row && row !== hovered) {
        hovered = row;
        fill((row as SVGElement).dataset);
      }
    });
    root.addEventListener("pointerout", (e) => {
      if (hovered && !hovered.contains(e.relatedTarget as Node | null)) {
        hovered = null;
        tip.hidden = true;
      }
    });
    root.addEventListener("pointermove", (e) => {
      if (hovered) placeTip(e.clientX, e.clientY);
    });
    root.addEventListener("focusin", (e) => {
      const row = rowOf(e.target);
      if (!row) return;
      fill((row as SVGElement).dataset);
      const b = row.getBoundingClientRect();
      placeTip(b.left + b.width * 0.3, b.top + b.height / 2);
    });
    root.addEventListener("focusout", (e) => {
      if (rowOf(e.target)) tip.hidden = true;
    });
  }
</script>

