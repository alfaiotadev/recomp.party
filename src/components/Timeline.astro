---
import { shortDate, type Entry } from "../lib/data.ts";
import { AXIS_H, layout, views, W } from "../lib/timeline.ts";

interface Props {
  games: Entry[];
}
const { games } = Astro.props;
const layouts = views().map((v) => layout(games, v));
const defaultView = "1y";
---

<section class="timeline" aria-label="Release timeline by platform">
  {layouts.map((l) => <input type="radio" name="tl-view" id={`tl-${l.view.id}`} checked={l.view.id === defaultView} />)}
  <div class="tl-head">
    <div>
      <p class="eyebrow">Release timeline</p>
      <h2>One lane per original platform</h2>
    </div>
    <div class="tl-tabs" role="group" aria-label="Time range">
      {layouts.map((l) => <label for={`tl-${l.view.id}`}>{l.view.label}</label>)}
    </div>
  </div>
  <p class="tl-legend">
    <span class="sw recomp"></span> static recompilation
    <span class="sw port"></span> source port
    <span class="sw pre"></span> pre-release
    — each row runs from a project's first release to its latest one.
  </p>
  <div class="tl-views">
    {
      layouts.map((l) => (
        <div class="tl-view" data-view={l.view.id}>
          <svg viewBox={`0 0 ${W} ${l.height}`} role="img" aria-label={`${l.view.label}: releases per platform`}>
            {l.lanes.map((lane, i) => (
              <g class="lane">
                <rect class={i % 2 ? "lane-bg odd" : "lane-bg"} x="0" y={lane.y} width={W} height={lane.height} />
                {lane.logo ? (
                  <image class="logo-img" href={lane.logo.src} x="12" y={lane.y + 10 + (24 - lane.logo.h) / 2} width={lane.logo.w} height={lane.logo.h}>
                    <title>{lane.name}</title>
                  </image>
                ) : (
                  <text class="lane-name" x="12" y={lane.y + 28}>
                    {lane.name}
                  </text>
                )}
                <text class="lane-count" x="12" y={lane.y + 48}>
                  {lane.rows.length} {lane.rows.length === 1 ? "project" : "projects"}
                </text>
              </g>
            ))}
            {l.ticks.map((t) => (
              <g class={t.major ? "tick major" : "tick"}>
                <line x1={t.x} x2={t.x} y1={AXIS_H - 4} y2={l.height} />
                <text x={t.x + 3} y={AXIS_H - 8}>
                  {t.label}
                </text>
              </g>
            ))}
            <line class="now" x1={l.nowX} x2={l.nowX} y1={AXIS_H - 4} y2={l.height} />
            {l.lanes.flatMap((lane, i) =>
              lane.rows.map((r) => (
                <a href={r.href} class={`row ${r.entry.kind}${i % 2 ? " odd" : ""}`}>
                  <title>
                    {`${r.entry.game} — ${r.entry.repo}\nfirst release ${shortDate(r.entry.firstReleaseAt!)}, latest ${shortDate(r.entry.latestReleaseAt!)} (${r.entry.snap?.releaseCount} releases)`}
                  </title>
                  <rect class="hit" x="0" y={r.y - 9} width={W} height="18" />
                  <line class="bar" x1={r.x1} x2={r.x2} y1={r.y} y2={r.y} />
                  {r.clipped && <path class="bar-clip" d={`M${r.x1 + 6} ${r.y - 4} L${r.x1} ${r.y} L${r.x1 + 6} ${r.y + 4}`} />}
                  {r.dots.map((d) => (
                    <circle class={d.prerelease ? "dot pre" : "dot"} cx={d.x} cy={r.y} r="3.2" />
                  ))}
                  <text class="label" x={r.label.x} y={r.y + 4} text-anchor={r.label.anchor}>
                    {r.entry.game}
                  </text>
                </a>
              )),
            )}
          </svg>
        </div>
      ))
    }
  </div>
</section>

<style>
  .timeline > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .tl-head h2 {
    margin: 0.2rem 0 0;
  }
  .tl-tabs {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .tl-tabs label {
    padding: 0.3rem 0.8rem;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 0.78rem;
    cursor: pointer;
    color: var(--muted);
  }
  .tl-tabs label:hover {
    color: var(--fg);
  }
  #tl-3m:checked ~ .tl-head label[for="tl-3m"],
  #tl-1y:checked ~ .tl-head label[for="tl-1y"],
  #tl-all:checked ~ .tl-head label[for="tl-all"] {
    background: var(--surface-2);
    color: var(--recomp);
    box-shadow: inset 0 0 0 1px rgb(124 240 197 / 0.3);
  }
  #tl-3m:focus-visible ~ .tl-head label[for="tl-3m"],
  #tl-1y:focus-visible ~ .tl-head label[for="tl-1y"],
  #tl-all:focus-visible ~ .tl-head label[for="tl-all"] {
    outline: 2px solid var(--recomp);
  }
  .tl-views {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }
  .tl-view {
    display: none;
    overflow-x: auto;
  }
  #tl-3m:checked ~ .tl-views [data-view="3m"],
  #tl-1y:checked ~ .tl-views [data-view="1y"],
  #tl-all:checked ~ .tl-views [data-view="all"] {
    display: block;
  }
  .tl-legend {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
    margin: 0.9rem 0 0.9rem;
  }
  .sw {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    margin: 0 0.3rem 0 1rem;
    vertical-align: -0.05rem;
  }
  .sw:first-child {
    margin-left: 0;
  }
  .sw.recomp {
    background: var(--recomp);
    box-shadow: 0 0 8px var(--recomp);
  }
  .sw.port {
    background: var(--port);
    box-shadow: 0 0 8px var(--port);
  }
  .sw.pre {
    border: 2px solid var(--muted);
  }
  svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
    font-family: var(--sans);
  }
  .lane-bg {
    fill: transparent;
  }
  .lane-bg.odd {
    fill: var(--lane);
  }
  .lane-name {
    font-size: 12px;
    font-weight: 650;
    fill: var(--fg);
  }
  .lane-count {
    font-family: var(--mono);
    font-size: 9.5px;
    fill: var(--faint);
  }
  .tick line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .tick.major line {
    stroke: var(--faint);
    stroke-dasharray: 2 3;
  }
  .tick text {
    font-family: var(--mono);
    font-size: 9.5px;
    fill: var(--faint);
  }
  .now {
    stroke: var(--accent);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 3px var(--accent));
  }
  .row .hit {
    fill: transparent;
  }
  .row:hover .hit,
  .row:focus-visible .hit {
    fill: var(--hover);
  }
  .bar {
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.5;
  }
  .bar-clip {
    fill: none;
    stroke-width: 1.5;
  }
  .row.recomp .bar,
  .row.recomp .bar-clip {
    stroke: var(--recomp);
  }
  .row.port .bar,
  .row.port .bar-clip {
    stroke: var(--port);
  }
  .row.recomp .dot {
    fill: var(--recomp);
  }
  .row.port .dot {
    fill: var(--port);
  }
  .row .dot {
    filter: drop-shadow(0 0 2.5px currentColor);
  }
  .row.recomp {
    color: var(--recomp);
  }
  .row.port {
    color: var(--port);
  }
  .row .dot.pre {
    fill: var(--surface);
    stroke-width: 1.5;
  }
  .row.recomp .dot.pre {
    stroke: var(--recomp);
  }
  .row.port .dot.pre {
    stroke: var(--port);
  }
  .label {
    font-size: 11px;
    fill: var(--fg);
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .row.odd .label {
    stroke: var(--lane);
  }
  .row:hover .label {
    fill: currentColor;
  }
  .row:hover .bar {
    opacity: 0.9;
  }
</style>
