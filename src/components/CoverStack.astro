---
/** A fanned, overlapping row of game covers, each linking to its project page. */
import { entryPath, type Entry } from "../lib/data.ts";

interface Props {
  entries: Entry[];
  /** Width of one cover in px; height follows the 3:4 cover shape. */
  size?: number;
  label?: string;
  /** Show at most this many covers; the rest become a "+N" chip. */
  max?: number;
  /** How much each cover tucks under the previous one, as a share of its width. */
  overlap?: number;
  /** Phones: wrap onto more rows with this many covers and this overlap (`always`: on every screen width). */
  wrap?: { max: number; overlap: number; always?: boolean };
}
const { entries, size = 34, label, max = Infinity, overlap = 0.45, wrap } = Astro.props;
const total = wrap ? Math.max(max, wrap.max) : max;
const shown = entries.slice(0, total);
const hidden = entries.length - Math.min(max, entries.length);
const hiddenWrapped = wrap ? entries.length - shown.length : 0;
---

{
  entries.length > 0 && (
    <ul class={wrap ? `stack wrap${wrap.always ? " always" : ""}` : "stack"} style={`--w:${size}px;--o:${overlap}${wrap ? `;--ow:${wrap.overlap}` : ""}`} aria-label={label}>
      {shown.map((e, i) => (
        <li class={i >= max ? "extra" : undefined} style={`--i:${i};--r:${i % 2 ? 3 : -3}deg`}>
          <a href={entryPath(e)} class={e.kind} title={e.game}>
            {e.cover ? (
              <img src={e.cover.src} width={e.cover.width} height={e.cover.height} alt={e.game} loading="lazy" decoding="async" />
            ) : (
              <span class="ph cover-ph icon" role="img" aria-label={e.game} />
            )}
          </a>
        </li>
      ))}
      {hidden > 0 && (
        <li class={wrap ? "more mono wide" : "more mono"} style={`--i:${shown.length};--r:0deg`}>
          +{hidden}
        </li>
      )}
      {hiddenWrapped > 0 && (
        <li class="more mono narrow" style={`--i:${shown.length};--r:0deg`}>
          +{hiddenWrapped}
        </li>
      )}
    </ul>
  )
}

<style>
  .stack {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* the overlap is a negative right margin, so a wrapped row starts flush left like the first */
  .stack li {
    margin-right: calc(var(--w) * var(--o) * -1);
    /* a gentle fan: alternate tilt, later covers sit lower in the pile */
    rotate: var(--r);
    z-index: calc(50 - var(--i));
    transition:
      translate 0.2s ease-out,
      rotate 0.2s ease-out;
  }
  .stack li:hover,
  .stack li:focus-within {
    z-index: 60;
    rotate: 0deg;
    translate: 0 -5px;
  }
  .stack a {
    display: block;
    width: var(--w);
    aspect-ratio: 3 / 4;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow:
      0 0 0 2px var(--surface),
      0 6px 14px -6px rgb(0 0 0 / 0.9);
    text-decoration: none;
  }
  .stack a:hover {
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 3px rgb(124 240 197 / 0.6),
      0 8px 18px -6px rgb(0 0 0 / 0.9);
  }
  .stack a.port:hover {
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 3px rgb(255 179 92 / 0.6),
      0 8px 18px -6px rgb(0 0 0 / 0.9);
  }
  .stack img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stack li.more {
    align-self: center;
    margin-left: calc(var(--w) * var(--o) + 0.5rem);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .stack li.extra,
  .stack li.more.narrow {
    display: none;
  }
  /* wrapped rows on every width: the same rules as the phone layout below */
  .stack.wrap.always {
    --o: var(--ow) !important;
    flex-wrap: wrap;
    row-gap: 8px;
    padding-right: calc(var(--w) * var(--o));
  }
  .stack.wrap.always li.extra,
  .stack.wrap.always li.more.narrow {
    display: block;
  }
  .stack.wrap.always li.more.wide {
    display: none;
  }
  @media (max-width: 520px) {
    .stack.wrap {
      --o: var(--ow) !important;
      flex-wrap: wrap;
      row-gap: 8px;
      padding-right: calc(var(--w) * var(--o));
    }
    .stack.wrap li.extra,
    .stack.wrap li.more.narrow {
      display: block;
    }
    .stack.wrap li.more.wide {
      display: none;
    }
  }
  .ph {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
