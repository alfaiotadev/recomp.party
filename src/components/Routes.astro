---
/**
 * One interactive map of the three routes from a console game to playing it on a PC: emulation, static
 * recompilation and source ports (via decompilation or released source). Shared boxes belong to several routes.
 * Nodes are HTML placed by percentage (wide screens --x/--y, phones --mx/--my); the lines are drawn by the script
 * from where the boxes actually are, so an opening box can push the ones below it down and the lines follow.
 */
type Path = "emu" | "recomp" | "port";
type Node = {
  id: string;
  ico: string;
  title: string;
  sub: string;
  detail: string;
  paths: Path[];
  d: [number, number, number]; // wide screens x%, y%, width%
  m: [number, number, number]; // phone x%, y%, width%
  chips?: string[];
  /** what travels down this box's outgoing lines (the step's product) */
  out: string;
  /** the icon's four-frame loop while the box is the active step */
  anim: "spin" | "bob" | "scan" | "gear" | "talk" | "flicker" | "wiggle";
};
const NODES: Node[] = [
  {
    id: "game",
    out: "💿",
    anim: "spin",
    ico: "💿",
    title: "Your copy of the game",
    sub: "as it shipped",
    chips: [".z64", ".iso", ".bin", ".xex", ".elf", ".exe", ".dll"],
    detail:
      "The game as it shipped: a cartridge dump, a disc image or the console's executables. Every route starts from your own copy, even a source port, which reads the art, music and levels from it.",
    paths: ["emu", "recomp", "port"],
    d: [40, 9, 34],
    m: [36, 9, 66],
  },
  {
    id: "source",
    out: "📜",
    anim: "bob",
    ico: "📂",
    title: "Released source",
    sub: "rare",
    detail:
      "Sometimes the developer publishes the code (Doom in 1997, Quake, a few later games). Then nobody has to decompile anything: porting can start right away.",
    paths: ["port"],
    d: [80, 9, 20],
    m: [85, 9, 26],
  },
  {
    id: "emulator",
    out: "🎮",
    anim: "talk",
    ico: "🗣️",
    title: "Emulator",
    sub: "translates while you play",
    detail:
      "Imitates the console's processor and chips, reading the game's instructions one by one as it runs. One emulator plays a whole library, but the translating never stops, so newer consoles need a strong PC.",
    paths: ["emu"],
    d: [20, 31, 22],
    m: [17, 30, 30],
  },
  {
    id: "recompiler",
    out: "🧾",
    anim: "bob",
    ico: "🤖",
    title: "Recompiler",
    sub: "translates once, automatically",
    detail:
      "Reads every function of the game's machine code once and writes equivalent C. Each game still needs setup and fixes by hand, typically weeks to months. Tools: N64: Recompiled, XenonRecomp, ReXGlue and more.",
    paths: ["recomp"],
    d: [50, 31, 22],
    m: [50, 30, 30],
  },
  {
    id: "decomp",
    out: "📜",
    anim: "scan",
    ico: "🔍",
    title: "Decompilation",
    sub: "people rewrite it in C",
    detail:
      "Fans rewrite the game in C by hand, function by function, until compiling it gives back the identical original (\"matching\"). It often takes years, and is the usual way a console game gets source code at all.",
    paths: ["port"],
    d: [80, 31, 22],
    m: [83, 30, 30],
  },
  {
    id: "genc",
    out: "🧾",
    anim: "wiggle",
    ico: "🧾",
    title: "Generated C",
    sub: "correct, not readable",
    detail:
      "Thousands of machine-written functions: faithful to the original, but full of registers and memory addresses instead of names. Modding hooks into it, but nobody edits it like normal code.",
    paths: ["recomp"],
    d: [50, 51, 22],
    m: [50, 47, 30],
  },
  {
    id: "src",
    out: "📜",
    anim: "wiggle",
    ico: "📜",
    title: "Readable source",
    sub: "named, commented",
    detail:
      "Source code people can read and change: named functions, comments, structure. Big changes like new renderers, mods and features become ordinary programming.",
    paths: ["port"],
    d: [80, 51, 22],
    m: [83, 47, 30],
  },
  {
    id: "build",
    out: "🖥️",
    anim: "gear",
    ico: "⚙️",
    title: "Compiler + runtime",
    sub: "PC graphics, sound, input",
    detail:
      "A normal compiler builds the C for x86 or ARM. A runtime (for recomps) or platform layer (for ports) stands in for the console's graphics, sound, controller and saves, using things like Vulkan, Metal and SDL.",
    paths: ["recomp", "port"],
    d: [65, 68, 36],
    m: [66, 63, 56],
  },
  {
    id: "native",
    out: "🎮",
    anim: "flicker",
    ico: "🖥️",
    title: "Native game",
    sub: "a real .exe or app",
    detail:
      "A real Windows, Mac, Linux or phone program. Widescreen, high frame rates and mods are now changes to that program, not hacks on top of an emulator.",
    paths: ["recomp", "port"],
    d: [65, 81, 36],
    m: [66, 77, 56],
  },
  {
    id: "play",
    out: "🎮",
    anim: "wiggle",
    ico: "🎮",
    title: "You play",
    sub: "on your PC",
    detail:
      "Every route ends here. Emulation gets there first for almost any game; recomps and ports take work per game but run lighter and can go further.",
    paths: ["emu", "recomp", "port"],
    d: [50, 94, 50],
    m: [50, 92, 70],
  },
];
/** side: route the line round the left or right of the map where a straight curve would run behind another box. */
type Edge = { from: string; to: string; paths: Path[]; side?: "left" | "right" };
const EDGES: Edge[] = [
  { from: "game", to: "emulator", paths: ["emu"] },
  { from: "game", to: "recompiler", paths: ["recomp"] },
  { from: "game", to: "decomp", paths: ["port"] },
  // the released-source box sits above the decompilation box, so its edge goes round the right side
  { from: "source", to: "src", paths: ["port"], side: "right" },
  // the emulator line runs down the left edge, clear of the compiler and native boxes
  { from: "emulator", to: "play", paths: ["emu"], side: "left" },
  { from: "recompiler", to: "genc", paths: ["recomp"] },
  { from: "decomp", to: "src", paths: ["port"] },
  { from: "genc", to: "build", paths: ["recomp"] },
  { from: "src", to: "build", paths: ["port"] },
  { from: "build", to: "native", paths: ["recomp", "port"] },
  { from: "native", to: "play", paths: ["recomp", "port"] },
];
const byId = Object.fromEntries(NODES.map((n) => [n.id, n]));
/** A source port has two ways in; until one is picked the map alternates between them (a: decompile your copy, b: released source). */
const BRANCH: Record<string, "a" | "b"> = { game: "a", decomp: "a", "game>decomp": "a", "decomp>src": "a", source: "b", "source>src": "b" };
const edgeClass = (e: Edge) => `edge ${e.paths.length > 1 ? "shared" : e.paths[0]}`;
const ROUTES: { key: Path | "all"; label: string; text: string }[] = [
  { key: "all", label: "All routes", text: "Pick a route to walk through it step by step, or click any box." },
  {
    key: "emu",
    label: "Emulation",
    text: "Your game goes straight into an emulator, which translates it while you play. No work per game, but it costs computing power forever.",
  },
  {
    key: "recomp",
    label: "Static recompilation",
    text: "A recompiler turns your game into C once. A compiler and a runtime make that into a native program, which loads everything else from your copy.",
  },
  {
    key: "port",
    label: "Source port",
    text: "Start from readable source code (rebuilt by fans in a decompilation, or rarely released) and build the game natively, with room to change anything.",
  },
];
---

<figure class="routes-fig" data-path="all">
  <div class="route-tabs" role="group" aria-label="Show a route">
    {
      ROUTES.map((r) => (
        <button type="button" class={`route-tab ${r.key}`} data-route={r.key} aria-pressed={r.key === "all" ? "true" : "false"}>
          {r.label}
        </button>
      ))
    }
  </div>
  <div class="routes">
    <svg class="edges" aria-hidden="true">
      {
        EDGES.map((e) => (
          <path
            class={edgeClass(e)}
            data-paths={e.paths.join(" ")}
            data-branch={BRANCH[`${e.from}>${e.to}`]}
            data-from={e.from}
            data-to={e.to}
            data-side={e.side}
          />
        ))
      }
    </svg>
    {
      NODES.map((n) => (
        <div
          class={`node ${n.paths.length === 1 ? n.paths[0] : "shared"} a-${n.anim}`}
          data-node={n.id}
          data-paths={n.paths.join(" ")}
          data-out={n.out}
          data-branch={BRANCH[n.id]}
          style={`--x:${n.d[0]};--y:${n.d[1]};--w:${n.d[2]};--mx:${n.m[0]};--my:${n.m[1]};--mw:${n.m[2]}`}
        >
          <button type="button" class="n-head" aria-expanded="false" aria-controls={`rd-${n.id}`}>
            <span class="n-ico" aria-hidden="true">{n.ico}</span>
            <span class="n-title">{n.title}</span>
            <span class="n-sub">{n.sub}</span>
            {n.chips && (
              <span class="n-chips">
                {n.chips.map((c, i) => (
                  <span style={`--i:${i};--n:${n.chips!.length}`}>{c}</span>
                ))}
              </span>
            )}
          </button>
          <div class="n-more" id={`rd-${n.id}`}>
            <div>
              <p class="n-detail">{n.detail}</p>
              <div class="n-next" data-next />
            </div>
          </div>
        </div>
      ))
    }
    <span class="token" aria-hidden="true" hidden></span>
  </div>
  <figcaption class="route-info" aria-live="polite">
    <b data-info-title>All routes</b>
    <span data-info-text>{ROUTES[0]!.text}</span>
  </figcaption>
  <script type="application/json" data-routes set:html={JSON.stringify(Object.fromEntries(ROUTES.map((r) => [r.key, r])))} />
  <script type="application/json" data-edges set:html={JSON.stringify(EDGES.map(({ from, to, paths }) => ({ from, to, paths })))} />
</figure>

<script>
  type EdgeData = { from: string; to: string; paths: string[] };
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  for (const fig of document.querySelectorAll<HTMLElement>(".routes-fig")) {
    const routes = JSON.parse(fig.querySelector("[data-routes]")!.textContent!) as Record<string, { label: string; text: string }>;
    const edges = JSON.parse(fig.querySelector("[data-edges]")!.textContent!) as EdgeData[];
    const title = fig.querySelector<HTMLElement>("[data-info-title]")!;
    const text = fig.querySelector<HTMLElement>("[data-info-text]")!;
    const map = fig.querySelector<HTMLElement>(".routes")!;
    const token = fig.querySelector<HTMLElement>(".token")!;
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>("[data-route]")];
    const nodes = new Map([...fig.querySelectorAll<HTMLElement>("[data-node]")].map((n) => [n.dataset.node!, n]));
    const label = (id: string) => nodes.get(id)!.querySelector(".n-title")!.textContent!;
    let active: string | null = null;
    let moving = 0;
    let picking = 0;
    const stopPick = () => {
      clearInterval(picking);
      delete fig.dataset.pick;
    };
    /** Source port: light up its two ways in by turns until the reader picks one. */
    const startPick = () => {
      stopPick();
      fig.dataset.pick = "a";
      picking = window.setInterval(() => (fig.dataset.pick = fig.dataset.pick === "a" ? "b" : "a"), 1600);
    };

    const svg = fig.querySelector<SVGSVGElement>(".edges")!;
    const lines = [...svg.querySelectorAll<SVGPathElement>("path")];
    const phone = matchMedia("(max-width: 900px)");

    /** Draw every line from where its boxes are right now. */
    const draw = () => {
      const m = map.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${m.width} ${m.height}`);
      const box = (id: string) => {
        const r = nodes.get(id)!.getBoundingClientRect();
        const x = r.left - m.left;
        const y = r.top - m.top;
        return { x, y, w: r.width, h: r.height, cx: x + r.width / 2, cy: y + r.height / 2, b: y + r.height, r: x + r.width };
      };
      for (const l of lines) {
        const f = box(l.dataset.from!);
        const t = box(l.dataset.to!);
        let d: string;
        if (l.dataset.side === "right") {
          const k = Math.max(16, m.width * 0.03);
          d = `M ${f.r} ${f.cy} C ${f.r + k * 2} ${f.cy}, ${t.r + k * 2} ${t.cy}, ${t.r} ${t.cy}`;
        } else if (l.dataset.side === "left") {
          // stay left of the target even when the source box has widened across the map (open, on phones)
          const x1 = Math.min(f.cx, t.x - 12);
          d = `M ${x1} ${f.b} C ${x1} ${t.cy}, ${x1} ${t.cy}, ${t.x} ${t.cy}`;
        } else {
          // fan out from wide boxes: leave from the part of the bottom edge that faces the target
          const x1 = f.cx + Math.max(-f.w / 3, Math.min(f.w / 3, (t.cx - f.cx) * 0.3));
          const ym = (f.b + t.y) / 2;
          d = `M ${x1} ${f.b} C ${x1} ${ym}, ${t.cx} ${ym}, ${t.cx} ${t.y}`;
        }
        l.setAttribute("d", d);
      }
    };
    /** Keep redrawing while boxes open, close and slide. */
    let drawing = 0;
    const follow = (ms = 500) => {
      const until = performance.now() + ms;
      cancelAnimationFrame(drawing);
      const tick = () => {
        draw();
        if (performance.now() < until) drawing = requestAnimationFrame(tick);
      };
      tick();
    };

    /** Boxes grow downwards when they open, so anchor each one by half its closed height. */
    const measure = () => {
      for (const n of nodes.values()) if (!n.classList.contains("open")) n.style.setProperty("--half", `${n.offsetHeight / 2}px`);
    };
    measure();
    draw();
    addEventListener("resize", () => {
      measure();
      push();
      follow(400);
    });

    /** Push every box below the open one down by however much it grew, and grow the map with it. */
    const push = () => {
      const n = active ? nodes.get(active)! : null;
      const extra = n ? n.querySelector<HTMLElement>(".n-more > div")!.scrollHeight : 0;
      const yOf = (el: HTMLElement) => parseFloat(el.style.getPropertyValue(phone.matches ? "--my" : "--y"));
      const y0 = n ? yOf(n) : Infinity;
      for (const o of nodes.values()) o.style.setProperty("--shift", `${yOf(o) > y0 + 0.5 ? extra : 0}px`);
      map.style.setProperty("--grow", `${extra}px`);
    };

    const route = () => fig.dataset.path!;
    const onRoute = (paths: string[]) => route() === "all" || paths.includes(route());

    const open = (id: string | null) => {
      active = id;
      // a way into the port has been picked: stop alternating and keep the other way faded
      const branch = id ? nodes.get(id)!.dataset.branch : undefined;
      if (id) clearInterval(picking);
      if (branch && route() === "port") fig.dataset.pick = branch;
      for (const [nid, n] of nodes) {
        const on = nid === id;
        n.classList.toggle("open", on);
        n.querySelector(".n-head")!.setAttribute("aria-expanded", String(on));
      }
      push();
      follow();
      if (!id) return;
      // the way on from here: every line out of this box that belongs to the chosen route
      const next = fig.querySelector<HTMLElement>(`[data-node="${id}"] [data-next]`)!;
      const outs = edges.filter((e) => e.from === id && onRoute(e.paths));
      if (!outs.length && route() !== "all") {
        const again = document.createElement("button");
        again.type = "button";
        again.textContent = "↺ Walk it again";
        again.className = route();
        again.addEventListener("click", (ev) => {
          ev.stopPropagation();
          show(route());
        });
        next.replaceChildren(again);
        return;
      }
      next.replaceChildren(
        ...edges
          .filter((e) => e.from === id && onRoute(e.paths))
          .map((e) => {
            const b = document.createElement("button");
            b.type = "button";
            b.textContent = `${label(e.to)} →`;
            b.className = nodes.get(e.to)!.classList[1]!;
            b.addEventListener("click", (ev) => {
              ev.stopPropagation();
              go(e.to);
            });
            return b;
          }),
      );
    };

    /** Send the active box's product down the line to `to`, then open `to`. */
    const go = (to: string) => {
      const run = ++moving;
      const from = active;
      const path = from ? svg.querySelector<SVGPathElement>(`path[data-from="${from}"][data-to="${to}"]`) : null;
      if (!path || still.matches) return open(to);
      open(null);
      token.textContent = nodes.get(from!)!.dataset.out!;
      token.hidden = false;
      const len = path.getTotalLength();
      // lengths are in pixels now: about half a second plus a little per 100 px, never dragging past 1.4 s
      const ms = Math.min(1400, 450 + len * 2.2);
      const t0 = performance.now();
      const step = (now: number) => {
        if (run !== moving) return;
        const k = Math.min(1, (now - t0) / ms);
        const e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
        const p = path.getPointAtLength(e * len);
        token.style.left = `${p.x}px`;
        token.style.top = `${p.y}px`;
        if (k < 1) return requestAnimationFrame(step);
        token.hidden = true;
        // the line just travelled stays lit, so the walk so far reads as one solid path
        for (const l of lines) if (l.dataset.from === from && l.dataset.to === to) l.classList.add("walked");
        open(to);
        const n = nodes.get(to)!;
        n.classList.remove("land");
        void n.offsetWidth;
        n.classList.add("land");
      };
      requestAnimationFrame(step);
    };

    /** Light a route up from the top down: each box and line waits by its distance from the start. */
    const stagger = () => {
      const depth = new Map<string, number>([["game", 0], ["source", 0]]);
      const live = edges.filter((e) => onRoute(e.paths));
      for (let changed = true; changed; ) {
        changed = false;
        for (const e of live) {
          const d = depth.get(e.from);
          if (d !== undefined && (depth.get(e.to) ?? Infinity) > d + 1) {
            depth.set(e.to, d + 1);
            changed = true;
          }
        }
      }
      for (const [id, n] of nodes) n.style.setProperty("--d", `${(depth.get(id) ?? 0) * 90}ms`);
      for (const l of lines) l.style.setProperty("--d", `${((depth.get(l.dataset.from!) ?? 0) + 0.5) * 90}ms`);
    };

    const show = (key: string) => {
      moving++;
      stopPick();
      for (const l of lines) l.classList.remove("walked");
      token.hidden = true;
      fig.dataset.path = key;
      stagger();
      for (const t of tabs) t.setAttribute("aria-pressed", String(t.dataset.route === key));
      title.textContent = routes[key]!.label;
      text.textContent = routes[key]!.text;
      // every route starts from the game file; a port can also start from released source, so let the reader choose
      stopPick();
      if (key === "port") {
        open(null);
        text.textContent = `${routes[key]!.text} Two ways in: click your game file or the released source.`;
        startPick();
      } else open(key === "all" ? null : "game");
    };
    for (const t of tabs) t.addEventListener("click", () => show(t.dataset.route!));
    for (const n of nodes.values()) n.addEventListener("animationend", (e) => e.animationName.endsWith("land") && n.classList.remove("land"));

    for (const [id, n] of nodes) {
      n.querySelector(".n-head")!.addEventListener("click", () => {
        if (id === active) return open(null);
        const paths = n.dataset.paths!.split(" ");
        if (!onRoute(paths)) {
          stopPick();
          fig.dataset.path = paths.length === 1 ? paths[0]! : "all";
          for (const t of tabs) t.setAttribute("aria-pressed", String(t.dataset.route === fig.dataset.path));
          title.textContent = routes[fig.dataset.path]!.label;
          text.textContent = routes[fig.dataset.path]!.text;
        }
        const linked = active && edges.some((e) => e.from === active && e.to === id);
        if (linked) go(id);
        else {
          moving++;
          token.hidden = true;
          open(id);
        }
      });
    }
  }
</script>

<style>
  .routes-fig {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .route-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }
  .route-tab {
    --tint: var(--muted);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--lane);
    color: var(--muted);
    font: 0.8rem var(--mono);
    cursor: pointer;
  }
  .route-tab.emu {
    --tint: var(--emu);
  }
  .route-tab.recomp {
    --tint: var(--recomp);
  }
  .route-tab.port {
    --tint: var(--port);
  }
  .route-tab:hover {
    color: var(--fg);
  }
  .route-tab[aria-pressed="true"] {
    border-color: var(--tint);
    color: var(--tint);
    background: color-mix(in srgb, var(--tint) 10%, var(--lane));
  }
  .route-tab.all[aria-pressed="true"] {
    color: var(--fg);
    border-color: var(--faint);
  }

  .routes {
    position: relative;
    /* room for the boxes an open step pushed down */
    margin-bottom: var(--grow, 0px);
    transition: margin-bottom 0.35s ease;
    aspect-ratio: 1100 / 820;
  }
  .edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .edge {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
    transition: opacity 0.25s;
  }
  .edge.emu {
    stroke: var(--emu);
  }
  .edge.recomp {
    stroke: var(--recomp);
  }
  .edge.port {
    stroke: var(--port);
  }
  .edge.shared {
    stroke: var(--faint);
  }

  .node {
    --tint: var(--muted);
    --half: 2.6rem;
    position: absolute;
    z-index: 1;
    left: calc(var(--x) * 1%);
    /* anchored at the top so an opening box grows downwards only */
    top: calc(var(--y) * 1% - var(--half));
    width: calc(var(--w) * 1%);
    translate: -50% var(--shift, 0px);
    border: 1px solid color-mix(in srgb, var(--tint) 40%, var(--line));
    border-radius: 12px;
    background: var(--surface-2);
    color: var(--muted);
    line-height: 1.25;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      width 0.3s,
      left 0.3s,
      translate 0.35s ease;
  }
  .n-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    width: 100%;
    padding: 0.5rem 0.4rem;
    border: 0;
    border-radius: inherit;
    background: none;
    color: inherit;
    font: inherit;
