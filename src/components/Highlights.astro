---
import { ago, entryPath, fitLogo, PLATFORMS, platformLogo } from "../lib/data.ts";
import { highlights } from "../lib/highlights.ts";

const { risers, fresh, platform } = highlights;
const slides = [
  risers.items.length && { id: "rising", label: risers.title },
  fresh.items.length && { id: "fresh", label: fresh.title },
  platform && { id: "platform", label: "Platform of the week" },
].filter(Boolean) as { id: string; label: string }[];
const mini = (id: Parameters<typeof platformLogo>[0]) => {
  const l = platformLogo(id);
  return l && { src: l.src, ...fitLogo(l, 56, 13) };
};
---

{
  slides.length > 0 && (
    <section class="hl" id="hl" aria-roledescription="carousel" aria-label="This week">
      <div class="hl-track" id="hl-track" tabindex="0">
        {risers.items.length > 0 && (
          <article class="slide" id="hl-rising" aria-label={risers.title}>
            <header>
              <p class="eyebrow">{risers.note}</p>
              <h2>{risers.title}</h2>
            </header>
            <ol class="items">
              {risers.items.map((r, i) => {
                const logo = mini(r.entry.platform);
                return (
                  <li>
                    <a href={r.entry.kind === "tool" ? r.entry.url : entryPath(r.entry)} class={`item ${r.entry.kind}`}>
                      <span class="rank mono">{String(i + 1).padStart(2, "0")}</span>
                      <span class="big mono">{r.value}</span>
                      <strong>{r.entry.game}</strong>
                      <span class="meta mono">
                        {logo ? <img class="logo-img" src={logo.src} width={logo.w} height={logo.h} alt={PLATFORMS[r.entry.platform]} /> : PLATFORMS[r.entry.platform]}
                        <span>{r.detail}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </article>
        )}
        {fresh.items.length > 0 && (
          <article class="slide" id="hl-fresh" aria-label={fresh.title}>
            <header>
              <p class="eyebrow">{fresh.note}</p>
              <h2>{fresh.title}</h2>
            </header>
            <ol class="items">
              {fresh.items.map((g) => {
                const logo = mini(g.platform);
                return (
                  <li>
                    <a href={entryPath(g)} class={`item ${g.kind}`}>
                      <span class={`badge ${g.kind}`}>{g.kind}</span>
                      <strong>{g.game}</strong>
                      <span class="meta mono">
                        {logo ? <img class="logo-img" src={logo.src} width={logo.w} height={logo.h} alt={PLATFORMS[g.platform]} /> : PLATFORMS[g.platform]}
                        <span>{ago(g.firstReleaseAt)}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </article>
        )}
        {platform && (
          <article class="slide plat-slide" id="hl-platform" aria-label="Platform of the week">
            <header>
              <p class="eyebrow">most releases in 7 days</p>
              <h2>Platform of the week</h2>
              <div class="plat-hero">
                {platform.logo ? (
                  <img class="logo-img" src={platform.logo.src} {...(() => { const b = fitLogo(platform.logo!, 220, 56); return { width: b.w, height: b.h }; })()} alt={platform.name} />
                ) : (
                  <span class="plat-name">{platform.name}</span>
                )}
                <p class="mono">
                  <span class="glow">{platform.releases}</span> releases · {platform.projects} {platform.projects === 1 ? "project" : "projects"}
                </p>
              </div>
            </header>
            <ol class="items">
              {platform.top.map((t) => (
                <li>
                  <a href={entryPath(t.entry)} class={`item ${t.entry.kind}`}>
                    <span class="big mono">{t.releases}×</span>
                    <strong>{t.entry.game}</strong>
                    <span class="meta mono">
                      <span>{t.entry.repo.split("/")[0]}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </article>
        )}
      </div>
      <button type="button" class="arrow prev" data-dir="-1" aria-label="Previous" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button type="button" class="arrow next" data-dir="1" aria-label="Next" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
      <div class="hl-tabs" role="tablist" id="hl-tabs" hidden>
        {slides.map((s, i) => (
          <button type="button" role="tab" class="tab" data-i={i} aria-selected={i === 0 ? "true" : "false"} aria-controls={`hl-${s.id}`}>
            <span class="tab-label">{s.label}</span>
            <span class="tab-bar"><span class="tab-fill" /></span>
          </button>
        ))}
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    const root = document.getElementById("hl");
    const track = document.getElementById("hl-track");
    const tabsEl = document.getElementById("hl-tabs");
    if (!root || !track || !tabsEl) return;
    const slides = [...track.children];
    const tabs = [...tabsEl.querySelectorAll(".tab")];
    if (slides.length < 2) return;
    for (const el of root.querySelectorAll("[hidden]")) el.hidden = false;

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DURATION = 7000;
    let i = 0;
    let programmatic = false; // true while a scroll was started by go(), not by the user
    let auto = !reduce; // turned off for good by any manual navigation

    // Countdown: progress runs 0 → 1 over DURATION and advances the page at 1. While hovered it
    // runs backwards at the same pace and rests at 0 — it never goes back a page.
    let progress = 0;
    let dir = 1;
    let last = performance.now();
    const draw = () => {
      tabs.forEach((t, k) => {
        const f = t.querySelector(".tab-fill");
        f.style.transform = `scaleX(${k === i ? (auto ? progress : 1) : 0})`;
      });
    };
    const tick = (now) => {
      const dt = now - last;
      last = now;
      if (auto && !document.hidden) {
        progress = Math.min(1, Math.max(0, progress + (dir * dt) / DURATION));
        if (progress >= 1) {
          progress = 0;
          go(i + 1);
        }
        draw();
      }
      if (auto) requestAnimationFrame(tick);
    };
    const mark = () => {
      tabs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
      draw();
    };
    const go = (n) => {
      i = (n + slides.length) % slides.length;
      progress = 0;
      programmatic = true;
      track.scrollTo({ left: i * track.clientWidth, behavior: reduce ? "auto" : "smooth" });
      mark();
    };
    const stopAuto = () => {
      auto = false;
      root.classList.add("manual");
      draw();
    };

    root.addEventListener("click", (e) => {
      const b = e.target.closest(".arrow, .tab");
      if (!b) return;
      stopAuto();
      go(b.dataset.dir ? i + Number(b.dataset.dir) : Number(b.dataset.i));
    });

    // Swiping or scrolling the track by hand also counts as taking control.
    for (const ev of ["pointerdown", "wheel", "touchstart"]) track.addEventListener(ev, () => (programmatic = false), { passive: true });
    let settle;
    track.addEventListener("scroll", () => {
      clearTimeout(settle);
      settle = setTimeout(() => {
        const n = Math.round(track.scrollLeft / track.clientWidth);
        if (!programmatic && n !== i) {
          stopAuto();
          i = n;
          mark();
        }
        programmatic = false;
      }, 120);
    }, { passive: true });

    track.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      stopAuto();
      go(i + (e.key === "ArrowRight" ? 1 : -1));
    });

    // Hover / focus: the countdown runs backwards; leaving lets it fill again from where it is.
    root.addEventListener("pointerenter", () => (dir = -1));
    root.addEventListener("pointerleave", () => (dir = 1));
    root.addEventListener("focusin", () => (dir = -1));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget)) dir = 1;
    });

    if (!auto) root.classList.add("manual");
    mark();
    if (auto) requestAnimationFrame((now) => {
      last = now;
      tick(now);
    });
  })();
</script>

<style>
  .hl {
    --arrow: 2.1rem;
    --tabs-h: 2.6rem;
    margin-top: 1.4rem;
    position: relative;
  }
  .hl-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: 1px solid var(--line);
    border-radius: 12px;
    background:
      linear-gradient(120deg, rgb(124 240 197 / 0.06), transparent 40%),
      var(--surface);
  }
  .hl-track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: minmax(180px, 230px) 1fr;
    gap: 1.5rem;
    padding: 1.3rem 1.4rem 1.4rem;
    min-height: 168px;
  }
  @media (max-width: 760px) {
    .slide {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
  .slide header h2 {
    margin: 0.3rem 0 0;
    font-size: 1.35rem;
  }
  .slide header .eyebrow {
    margin: 0;
    color: var(--recomp);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.6rem;
  }
  /* medium widths fit four cards per row: drop the fifth instead of leaving it alone on a row */
  @media (min-width: 761px) and (max-width: 1180px) {
    .items li:nth-child(5) {
      display: none;
    }
  }
  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: rgb(11 13 20 / 0.55);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .item.recomp:hover,
  .item.tool:hover {
    border-color: rgb(124 240 197 / 0.45);
    box-shadow: 0 6px 24px -12px rgb(124 240 197 / 0.5);
  }
  .item.port:hover {
    border-color: rgb(255 179 92 / 0.45);
    box-shadow: 0 6px 24px -12px rgb(255 179 92 / 0.5);
  }
  .item strong {
    font-size: 0.92rem;
    line-height: 1.25;
  }
  .item .badge {
    align-self: flex-start;
  }
  .rank {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    font-size: 0.68rem;
    color: var(--faint);
  }
  .big {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .item.recomp .big,
  .item.tool .big {
    color: var(--recomp);
    text-shadow: 0 0 14px rgb(124 240 197 / 0.4);
  }
  .item.port .big {
    color: var(--port);
    text-shadow: 0 0 14px rgb(255 179 92 / 0.4);
  }
  .meta {
    margin-top: auto;
    padding-top: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .meta img {
    opacity: 0.55;
  }
  .plat-hero {
    margin-top: 1rem;
  }
  .plat-hero img {
    opacity: 0.9;
    filter: brightness(0) invert(1) drop-shadow(0 0 10px rgb(124 240 197 / 0.35));
  }
  .plat-hero p {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .plat-name {
    font-size: 1.6rem;
    font-weight: 700;
  }
  /* arrows sit on the carousel's edges, half outside the frame */
  .arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: var(--arrow);
    height: var(--arrow);
    /* centre on the slide area (the section also contains the tab row) */
    margin-top: calc(var(--arrow) / -2 - var(--tabs-h) / 2);
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgb(18 22 36 / 0.92);
    backdrop-filter: blur(6px);
    color: var(--muted);
    cursor: pointer;
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.8);
    transition: color 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .arrow[hidden],
  .hl-tabs[hidden] {
    display: none;
  }
  .arrow.prev {
    left: calc(var(--arrow) / -2);
  }
  .arrow.next {
    right: calc(var(--arrow) / -2);
  }
  .arrow:hover,
  .arrow:focus-visible {
    color: var(--recomp);
    border-color: rgb(124 240 197 / 0.5);
    box-shadow: 0 0 16px -4px rgb(124 240 197 / 0.5);
  }
  .arrow svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 760px) {
    .arrow.prev {
      left: 0.35rem;
    }
    .arrow.next {
      right: 0.35rem;
    }
    /* phones: swipe or tap a tab; edge arrows would cover the cards */
    .arrow {
      display: none;
    }
  }

  /* page tabs: centred, each with a bar that fills while the page is shown */
  .hl-tabs {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    height: var(--tabs-h);
    padding-top: 0.55rem;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    width: clamp(6.5rem, 22vw, 11rem);
    padding: 0.15rem 0.2rem;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
  }
  .tab-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    transition: color 0.2s;
  }
  .tab:hover .tab-label {
    color: var(--muted);
  }
  .tab[aria-selected="true"] .tab-label {
    color: var(--fg);
  }
  .tab-bar {
    position: relative;
    height: 2px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .tab-fill {
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(0);
    background: var(--recomp);
    box-shadow: 0 0 6px var(--recomp);
  }
  @media (max-width: 520px) {
    .tab-label {
      font-size: 0.6rem;
    }
  }
</style>
