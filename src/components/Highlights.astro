---
import PlatformGhost from "./PlatformGhost.astro";
import { ago, entryPath, fitLogo, PLATFORMS, platformLogo } from "../lib/data.ts";
import { recentCredits, shortModel } from "../lib/ai.ts";
import { highlights } from "../lib/highlights.ts";
import { CREDIT_ICONS } from "../lib/vendor-icons.ts";
import CoverStack from "./CoverStack.astro";
import StarTrend from "./StarTrend.astro";

const { risers, starTrend, fresh, platform, most } = highlights;
const models = recentCredits(7);
const slides = [
  risers.items.length && { id: "rising", label: risers.title },
  fresh.items.length && { id: "fresh", label: fresh.title },
  platform && { id: "platform", label: "Platform of the week" },
  most.length && { id: "most", label: "Most recompiled" },
  models.ranking.length && { id: "models", label: "Top models" },
].filter(Boolean) as { id: string; label: string }[];
/** GitHub's star (Primer Octicons star-16 / star-fill-16, MIT). */
const STAR =
  "M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z";
const STAR_FILL =
  "M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z";

/** Rotated by the decode animation in "+N earlier awesome releases". */
const ADJECTIVES = [
  "awesome", "glorious", "native", "shiny", "legendary", "tubular", "radical", "pixel-perfect",
  "buttery-smooth", "60-fps", "widescreen", "turbo", "delightful", "bodacious", "spicy", "lovingly-ported",
  "nostalgic", "crunchy", "blast-processed", "uncapped",
];
const mini = (id: Parameters<typeof platformLogo>[0]) => {
  const l = platformLogo(id);
  return l && { src: l.src, ...fitLogo(l, 56, 13) };
};
---

{
  slides.length > 0 && (
    <section class="hl" id="hl" aria-roledescription="carousel" aria-label="This week">
      <div class="hl-track" id="hl-track" tabindex="0">
        {risers.items.length > 0 && (
          <article class="slide" id="hl-rising" aria-label={risers.title}>
            <header>
              <p class="eyebrow">{risers.note}</p>
              <h2 class="rs-title">
                <svg class="star-fill" viewBox="0 0 16 16" aria-hidden="true"><path d={STAR_FILL} /></svg>
                {risers.title}
              </h2>
              <StarTrend days={starTrend} />
            </header>
            <ol class="items">
              {risers.items.map((r, i) => {
                const logo = mini(r.entry.platform);
                return (
                  <li>
                    <a href={entryPath(r.entry)} class={`item ${r.entry.kind}${r.entry.cover ? " has-art" : " no-art"}`}>
                      {r.entry.cover ? <img class="art" src={r.entry.cover.src} width={r.entry.cover.width} height={r.entry.cover.height} alt="" loading="lazy" decoding="async" /> : <PlatformGhost platform={r.entry.platform} />}
                      <span class="rank mono">{String(i + 1).padStart(2, "0")}</span>
                      <span class="big mono">
                        {r.value}
                        {r.growth && (
                          <svg class="star-fill" viewBox="0 0 16 16" aria-label="stars">
                            <path d={STAR_FILL} />
                          </svg>
                        )}
                      </span>
                      {r.growth && <span class="growth mono">{r.growth}</span>}
                      <strong>{r.entry.game}</strong>
                      <span class="meta mono">
                        {logo ? <img class="logo-img" src={logo.src} width={logo.w} height={logo.h} alt={PLATFORMS[r.entry.platform]} /> : PLATFORMS[r.entry.platform]}
                        <span class="gh-star" title={`${r.stars.toLocaleString("en")} stars on GitHub`}>
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d={STAR} /></svg>
                          <span>{r.stars.toLocaleString("en")}</span>
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </article>
        )}
        {fresh.items.length > 0 && (
          <article class="slide" id="hl-fresh" aria-label={fresh.title}>
            <header>
              <p class="eyebrow">{fresh.note}</p>
              <h2>{fresh.title}</h2>
              {fresh.rest.length > 0 && (
                <div class="more-new">
                  <CoverStack entries={fresh.rest} size={40} max={8} wrap={{ max: 14, overlap: 0.15 }} label="Earlier new releases" />
                  <a class="mono" href="/#all-games">
                    +{fresh.rest.length} earlier <span class="decode" data-words={JSON.stringify(ADJECTIVES)}>awesome</span>{" "}
                    {fresh.rest.length === 1 ? "release" : "releases"}
                  </a>
                </div>
              )}
            </header>
            <ol class="items">
              {fresh.items.map((g) => {
                const logo = mini(g.platform);
                return (
                  <li>
                    <a href={entryPath(g)} class={`item ${g.kind}${g.cover ? " has-art" : " no-art"}`}>
                      {g.cover ? <img class="art" src={g.cover.src} width={g.cover.width} height={g.cover.height} alt="" loading="lazy" decoding="async" /> : <PlatformGhost platform={g.platform} />}
                      <span class={`badge ${g.kind}`}>{g.kind}</span>
                      <strong>{g.game}</strong>
                      <span class="meta mono">
                        {logo ? <img class="logo-img" src={logo.src} width={logo.w} height={logo.h} alt={PLATFORMS[g.platform]} /> : PLATFORMS[g.platform]}
                        <span>{ago(g.firstReleaseAt)}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </article>
        )}
        {platform && (
          <article class="slide plat-slide" id="hl-platform" aria-label="Platform of the week">
            <header>
              <p class="eyebrow">most releases in 7 days</p>
              <h2>Platform of the week</h2>
              <ol class="plat-rank" aria-label="Releases in the last 7 days by platform">
                {platform.ranking.map((r, k) => {
                  // equal visual area, so square marks (Switch) aren't dwarfed by wide wordmarks
                  const h = r.logo && Math.min(15, Math.sqrt(230 / r.logo.aspect), 44 / r.logo.aspect);
                  const box = r.logo && h && { w: +(h * r.logo.aspect).toFixed(1), h: +h.toFixed(1) };
                  return (
                    <li class={k === 0 ? "win" : ""}>
                      <span class="r-plat" title={r.name}>
                        {r.logo && box ? <img class="logo-img" src={r.logo.src} width={box.w} height={box.h} alt={r.name} /> : <span class="r-text">{r.name.split(" ")[0]}</span>}
                      </span>
                      <span class="r-bar"><span style={`width:${(r.releases / platform.ranking[0]!.releases) * 100}%`} /></span>
                      <span class="r-n mono">{r.releases}</span>
                    </li>
                  );
                })}
              </ol>
              <p class="mono weeks">
                {platform.name} #1 for <b>{platform.weeksOnTop}</b> {platform.weeksOnTop === 1 ? "week" : "weeks"} in total
                {platform.streak > 1 && <> · {platform.streak} in a row</>}
              </p>
            </header>
            <ol class="items">
              {platform.top.map((t) => (
                <li>
                  <a href={entryPath(t.entry)} class={`item ${t.entry.kind}${t.entry.cover ? " has-art" : " no-art"}`}>
                    {t.entry.cover ? <img class="art" src={t.entry.cover.src} width={t.entry.cover.width} height={t.entry.cover.height} alt="" loading="lazy" decoding="async" /> : <PlatformGhost platform={t.entry.platform} />}
                    <span class="big mono">{t.releases}×</span>
                    <strong>{t.entry.game}</strong>
                    <span class="meta mono">
                      <span>{t.entry.repo.split("/")[0]}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </article>
        )}
        {most.length > 0 && (
          <article class="slide" id="hl-most" aria-label="Most recompiled games">
            <header>
              <p class="eyebrow">projects per game</p>
              <h2>Most recompiled games</h2>
              <p class="most-note mono">Recomps and ports of the same game, across every platform it came from.</p>
            </header>
            <ol class="items">
              {most.map((m, i) => (
                <li>
                  <a href={m.href} class={`item ${m.kind}${m.cover ? " has-art" : " no-art"}`} title={`${m.title}: show all ${m.count} projects`}>
                    {m.cover ? <img class="art" src={m.cover.src} width={m.cover.width} height={m.cover.height} alt="" loading="lazy" decoding="async" /> : <PlatformGhost platform={m.platforms[0]!.id} />}
                    <span class="rank mono">{String(i + 1).padStart(2, "0")}</span>
                    <span class="big mono">×{m.count}</span>
                    <span class="growth mono">{[m.recomps && `${m.recomps} recomp${m.recomps > 1 ? "s" : ""}`, m.ports && `${m.ports} port${m.ports > 1 ? "s" : ""}`].filter(Boolean).join(" · ")}</span>
                    <strong>{m.title}</strong>
                    <span class="meta mono plats">
                      {m.platforms.map((p) => {
                        const logo = mini(p.id);
                        return logo ? <img class="logo-img" src={logo.src} width={logo.w} height={logo.h} alt={p.name} title={p.name} /> : <span title={p.name}>{p.name.split(" ")[0]}</span>;
                      })}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </article>
        )}
        {models.ranking.length > 0 && (
          <article class="slide plat-slide" id="hl-models" aria-label="Top models this week">
            <header>
              <p class="eyebrow">credited commits in 7 days</p>
              <h2>Top models</h2>
              <ol class="plat-rank model-rank" aria-label="Credited commits in the last 7 days by model">
                {models.ranking.map((r, k) => (
                  <li class={`${k === 0 ? "win " : ""}v-${r.vendor}`}>
                    <span class="r-model">
                      {CREDIT_ICONS[r.vendor] && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d={CREDIT_ICONS[r.vendor]} />
                        </svg>
                      )}
                      {shortModel(r.model)}
                    </span>
                    <span class="r-bar"><span style={`width:${(r.commits / models.ranking[0]!.commits) * 100}%`} /></span>
                    <span class="r-n mono">{r.commits.toLocaleString("en")}</span>
                  </li>
                ))}
              </ol>
              <p class="mono weeks">
                <a href="/models/">{models.total.toLocaleString("en")} credited commits this week · all models →</a>
              </p>
            </header>
            <ol class="items">
              {models.top.map((t) => (
                <li>
                  <a href={entryPath(t.entry)} class={`item ${t.entry.kind}${t.entry.cover ? " has-art" : " no-art"}`}>
                    {t.entry.cover ? <img class="art" src={t.entry.cover.src} width={t.entry.cover.width} height={t.entry.cover.height} alt="" loading="lazy" decoding="async" /> : <PlatformGhost platform={t.entry.platform} />}
                    <span class="big mono">{t.commits.toLocaleString("en")}</span>
                    <span class="growth mono">commits · mostly {shortModel(t.model)}</span>
                    <strong>{t.entry.game}</strong>
                    <span class="meta mono">
                      <span>{t.entry.repo.split("/")[0]}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </article>
        )}
      </div>
      <button type="button" class="arrow prev" data-dir="-1" aria-label="Previous" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button type="button" class="arrow next" data-dir="1" aria-label="Next" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
      </button>
      <div class="hl-tabs" role="tablist" id="hl-tabs" hidden>
        {slides.map((s, i) => (
          <button type="button" role="tab" class="tab" data-i={i} aria-selected={i === 0 ? "true" : "false"} aria-controls={`hl-${s.id}`}>
            <span class="tab-label">{s.label}</span>
            <span class="tab-bar"><span class="tab-fill" /></span>
          </button>
        ))}
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    const root = document.getElementById("hl");
    const track = document.getElementById("hl-track");
    const tabsEl = document.getElementById("hl-tabs");
    if (!root || !track || !tabsEl) return;
    const slides = [...track.children];
    const tabs = [...tabsEl.querySelectorAll(".tab")];
    if (slides.length < 2) return;
    for (const el of root.querySelectorAll("[hidden]")) el.hidden = false;

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DURATION = 7000;
    let i = 0;
    let programmatic = false; // true while a scroll was started by go(), not by the user
    let auto = !reduce; // turned off for good by any manual navigation

    // Countdown: progress runs 0 → 1 over DURATION and advances the page at 1. While hovered it
    // runs backwards at the same pace and rests at 0 — it never goes back a page.
    let progress = 0;
    let dir = 1;
    let last = performance.now();
    const draw = () => {
      tabs.forEach((t, k) => {
        const f = t.querySelector(".tab-fill");
        f.style.transform = `scaleX(${k === i ? (auto ? progress : 1) : 0})`;
      });
    };
    const tick = (now) => {
      const dt = now - last;
      last = now;
      if (auto && !document.hidden) {
        progress = Math.min(1, Math.max(0, progress + (dir * dt) / DURATION));
        if (progress >= 1) {
          progress = 0;
          go(i + 1);
        }
        draw();
      }
      if (auto) requestAnimationFrame(tick);
    };
    // The tabs sit on a wheel: the current one in the middle, the rest around it in a ring, so the
    // first page's left neighbour is the last. A page change turns the wheel the short way round; a tab
    // that wraps from one end to the other jumps there without sliding (it is faded out at the edges).
    const n = tabs.length;
    const half = Math.floor(n / 2);
    const ring = (x) => ((x % n) + n) % n;
    let turn = 0; // counts whole turns too, so the wheel keeps one direction across the wrap
    let shown = 0;
    const spin = () => {
      let d = ring(i - shown);
      if (d > n / 2) d -= n;
      turn += d;
      shown = i;
      tabs.forEach((t, k) => {
        const o = ring(k - turn + half) - half;
        t.classList.toggle("jump", t.dataset.o !== undefined && Math.abs(o - Number(t.dataset.o)) > 1);
        t.dataset.o = String(o);
        t.style.setProperty("--o", String(o));
        t.classList.toggle("far", Math.abs(o) > 1);
      });
    };
    spin();
    const mark = () => {
      tabs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
      spin();
      draw();
    };
    const go = (n) => {
      i = (n + slides.length) % slides.length;
      progress = 0;
      programmatic = true;
      track.scrollTo({ left: i * track.clientWidth, behavior: reduce ? "auto" : "smooth" });
      mark();
    };
    const stopAuto = () => {
      auto = false;
      root.classList.add("manual");
      draw();
    };

    root.addEventListener("click", (e) => {
      const b = e.target.closest(".arrow, .tab");
      if (!b) return;
      stopAuto();
      go(b.dataset.dir ? i + Number(b.dataset.dir) : Number(b.dataset.i));
    });

    // Swiping or scrolling the track by hand also counts as taking control.
    for (const ev of ["pointerdown", "wheel", "touchstart"]) track.addEventListener(ev, () => (programmatic = false), { passive: true });
    let settle;
    track.addEventListener("scroll", () => {
      clearTimeout(settle);
      settle = setTimeout(() => {
        const n = Math.round(track.scrollLeft / track.clientWidth);
        if (!programmatic && n !== i) {
          stopAuto();
          i = n;
          mark();
        }
        programmatic = false;
      }, 120);
    }, { passive: true });

    track.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      stopAuto();
      go(i + (e.key === "ArrowRight" ? 1 : -1));
    });

    // Hover / focus: the countdown runs backwards; leaving lets it fill again from where it is.
    root.addEventListener("pointerenter", () => (dir = -1));
    root.addEventListener("pointerleave", () => (dir = 1));
    root.addEventListener("focusin", () => (dir = -1));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget)) dir = 1;
    });

    if (!auto) root.classList.add("manual");
    mark();
    if (auto) requestAnimationFrame((now) => {
      last = now;
      tick(now);
    });
  })();
</script>

<style>
  .hl {
    --arrow: 2.1rem;
    --tabs-h: 2.6rem;
    margin-top: 1.4rem;
    position: relative;
  }
  .hl-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: 1px solid var(--line);
    border-radius: 12px;
    background:
      linear-gradient(120deg, rgb(124 240 197 / 0.06), transparent 40%),
      var(--surface);
  }
  .hl-track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: minmax(180px, 230px) 1fr;
    gap: 1.5rem;
    padding: 1.3rem 1.4rem 1.4rem;
    min-height: 168px;
  }
  @media (max-width: 760px) {
    /* every slide is as tall as the tallest one: the card rows grow to share the spare height */
    .slide {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: 0.8rem;
    }
    .slide .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
  }
  .slide header h2 {
    margin: 0.3rem 0 0;
    font-size: 1.35rem;
  }
  .slide header .eyebrow {
    margin: 0;
    color: var(--recomp);
  }
  .more-new {
    margin-top: 0.9rem;
  }
  .more-new a {
    display: inline-block;
    margin-top: 0.55rem;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
  }
  .more-new a:hover {
    color: var(--fg);
  }
  /* cover as the card's backdrop, shaded where the text sits */
  .item.has-art,
  .item.no-art {
    isolation: isolate;
    overflow: hidden;
  }
  .item .art {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.06;
    transition: scale 0.5s ease-out;
    /* stay on a GPU layer, or the last frame of the zoom snaps when the browser re-rasterises */
    will-change: transform;
    backface-visibility: hidden;
  }
  .item:hover .art {
    scale: 1;
  }
  /* no cover: kind-coloured glow over the faint platform mark, as on the game cards */
  .item.no-art {
    background: radial-gradient(120% 70% at 50% 0%, rgb(124 240 197 / 0.1), transparent 70%), rgb(11 13 20 / 0.55);
  }
  .item.no-art.port {
    background: radial-gradient(120% 70% at 50% 0%, rgb(255 179 92 / 0.1), transparent 70%), rgb(11 13 20 / 0.55);
  }
  .item.has-art::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(11 13 20 / 0.92) 0, rgb(11 13 20 / 0.55) 38%, rgb(11 13 20 / 0.2) 60%, rgb(11 13 20 / 0.9) 100%);
  }
  .item.has-art strong {
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.8);
  }
  .decode {
    color: var(--recomp);
    text-shadow: 0 0 10px rgb(124 240 197 / 0.45);
    white-space: nowrap;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.6rem;
  }
  /* one row of cards above phone width: five fit, medium widths four; phones show all six in rows of two */
  @media (min-width: 761px) {
    .items li:nth-child(n + 6) {
      display: none;
    }
  }
  @media (min-width: 761px) and (max-width: 1180px) {
    .items li:nth-child(5) {
      display: none;
    }
  }
  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: rgb(11 13 20 / 0.55);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .item.recomp:hover {
    border-color: rgb(124 240 197 / 0.45);
    box-shadow: 0 6px 24px -12px rgb(124 240 197 / 0.5);
  }
  .item.port:hover {
    border-color: rgb(255 179 92 / 0.45);
    box-shadow: 0 6px 24px -12px rgb(255 179 92 / 0.5);
  }
  .item strong {
    font-size: 0.92rem;
    line-height: 1.25;
  }
  .item .badge {
    align-self: flex-start;
  }
  .rank {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    font-size: 0.68rem;
    color: var(--faint);
  }
  .big {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .item.mixed:hover {
    border-color: rgb(232 236 246 / 0.35);
    box-shadow: 0 6px 24px -12px rgb(232 236 246 / 0.35);
  }
  .item.mixed .big {
    color: var(--fg);
    text-shadow: 0 0 14px rgb(232 236 246 / 0.3);
  }
  .most-note {
    margin: 0.7rem 0 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .meta.plats {
    justify-content: flex-start;
    gap: 0.55rem;
  }
  .item.recomp .big {
    color: var(--recomp);
    text-shadow: 0 0 14px rgb(124 240 197 / 0.4);
  }
  .item.port .big {
    color: var(--port);
    text-shadow: 0 0 14px rgb(255 179 92 / 0.4);
  }
  .big {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .star-fill {
    width: 0.8em;
    height: 0.8em;
    fill: currentColor;
    filter: drop-shadow(0 0 4px currentColor);
    flex: none;
  }
  .rs-title {
    display: flex;
    align-items: center;
