---
/**
 * Stars gained per day across all games, as a small line with each day's value above its point. The readout
 * under it shows the latest day and follows the pointer. With a single day of history there is no line yet,
 * only the readout.
 */
import type { StarDay } from "../lib/highlights.ts";

interface Props {
  days: StarDay[];
}
const { days } = Astro.props;
const W = 200;
const H = 36; // drawing units; the chart is stretched to its CSS height
const PAD = 4; // room for the end marker
const max = Math.max(1, ...days.map((d) => d.gained));
const x = (i: number) => PAD + (days.length > 1 ? (i / (days.length - 1)) * (W - 2 * PAD) : W / 2);
const y = (v: number) => H - PAD - (Math.max(0, v) / max) * (H - 2 * PAD);
const points = days.map((d, i) => ({ x: +x(i).toFixed(1), y: +y(d.gained).toFixed(1), ...d }));
const line = points.map((p, i) => `${i ? "L" : "M"}${p.x} ${p.y}`).join(" ");
const area = `${line} L${points.at(-1)?.x} ${H} L${points[0]?.x} ${H} Z`;
const fmt = (d: StarDay) =>
  `+${d.gained.toLocaleString("en")} ★ ${new Date(d.date).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" })}`;
const last = days.at(-1);
---

{
  last && (
    <figure class="trend" data-points={JSON.stringify(points.map((p) => ({ x: p.x, y: p.y, t: fmt(p) })))}>
      {points.length > 1 && (
        <div class="plot">
        {/* stretched to the height CSS gives it (taller on desktop); strokes keep their width */}
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`Stars gained per day: ${days.map(fmt).join(", ")}`}>
          <path class="area" d={area} />
          <path class="line" d={line} />
          <line class="cross" x1="0" x2="0" y1="0" y2={H} hidden />
        </svg>
        {/* an HTML dot stays round however the chart is stretched */}
        <span class="dot" style={`left:${((points.at(-1)!.x / W) * 100).toFixed(2)}%;top:${((points.at(-1)!.y / H) * 100).toFixed(2)}%`} aria-hidden="true" />
        {/* HTML labels over the SVG, so the text keeps its size however wide the chart is drawn */}
        {points.map((p, i) => (
          <span
            class={`val mono${i === 0 ? " first" : ""}${i === points.length - 1 ? " last on" : ""}`}
            style={`left:${((p.x / W) * 100).toFixed(2)}%;top:${((p.y / H) * 100).toFixed(2)}%`}
            aria-hidden="true"
          >
            {p.gained.toLocaleString("en")}
          </span>
        ))}
        </div>
      )}
      <figcaption class="mono">
        <b>+{last.gained.toLocaleString("en")}</b> stars since yesterday
      </figcaption>
    </figure>
  )
}

<script>
  for (const fig of document.querySelectorAll<HTMLElement>(".trend")) {
    const svg = fig.querySelector("svg");
    if (!svg) continue;
    const pts: { x: number; y: number; t: string }[] = JSON.parse(fig.dataset.points!);
    const dot = fig.querySelector<HTMLElement>(".dot")!;
    const { width: VW, height: VH } = svg.viewBox.baseVal;
    const cross = svg.querySelector<SVGLineElement>(".cross")!;
    const cap = fig.querySelector("figcaption")!;
    const vals = [...fig.querySelectorAll<HTMLElement>(".val")];
    const mark = (i: number) => vals.forEach((v, k) => v.classList.toggle("on", k === i));
    const rest = cap.innerHTML;
    const show = (p: (typeof pts)[number]) => {
      dot.style.left = `${(p.x / VW) * 100}%`;
      dot.style.top = `${(p.y / VH) * 100}%`;
      cross.setAttribute("x1", String(p.x));
      cross.setAttribute("x2", String(p.x));
    };
    svg.addEventListener("pointermove", (ev) => {
      const r = svg.getBoundingClientRect();
      const vx = ((ev.clientX - r.left) / r.width) * svg.viewBox.baseVal.width;
      const p = pts.reduce((a, b) => (Math.abs(b.x - vx) < Math.abs(a.x - vx) ? b : a));
      show(p);
      mark(pts.indexOf(p));
      cross.hidden = false;
      cap.textContent = p.t;
    });
    svg.addEventListener("pointerleave", () => {
      show(pts.at(-1)!);
      mark(pts.length - 1);
      cross.hidden = true;
      cap.innerHTML = rest;
    });
  }
</script>

<style>
  .trend {
    margin: 1.6rem 0 0; /* headroom for the value labels */
  }
  .plot {
    position: relative;
    max-width: 200px;
  }
  /* phones: the chart spans the card */
  @media (max-width: 720px) {
    .plot {
      max-width: none;
    }
  }
  .val {
    position: absolute;
    translate: -50% calc(-100% - 6px);
    font-size: 0.6rem;
    line-height: 1;
    color: var(--faint);
    white-space: nowrap;
    pointer-events: none;
  }
  .val.first {
    translate: -4px calc(-100% - 6px);
  }
  .val.last {
    translate: calc(-100% + 4px) calc(-100% - 6px);
  }
  .val.on {
    color: var(--recomp);
  }
  svg {
    display: block;
    width: 100%;
    height: 3.6rem;
    overflow: visible;
    cursor: crosshair;
  }
  /* desktop: the header column has height to spare */
  @media (min-width: 721px) {
    svg {
      height: 5.5rem;
    }
  }
  .area {
    fill: rgb(124 240 197 / 0.1);
  }
  .line {
    fill: none;
    stroke: var(--recomp);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  /* the hidden attribute alone doesn't hide an SVG element */
  .cross[hidden] {
    display: none;
  }
  .cross {
    stroke: var(--faint);
    stroke-width: 1;
    stroke-dasharray: 2 2;
    vector-effect: non-scaling-stroke;
  }
  .dot {
    position: absolute;
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: var(--recomp);
    box-shadow: 0 0 6px rgb(124 240 197 / 0.7);
    pointer-events: none;
  }
  figcaption {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  figcaption b {
    color: var(--fg);
    font-weight: 600;
  }
</style>
