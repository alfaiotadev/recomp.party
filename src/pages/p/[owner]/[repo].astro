---
import Base from "../../../layouts/Base.astro";
import { aiOf, aiSince, shortModel } from "../../../lib/ai.ts";
import { LINK_ICONS } from "../../../lib/link-icons.ts";
import { moreLikeThis } from "../../../lib/related.ts";
import { CREDIT_ICONS } from "../../../lib/vendor-icons.ts";
import { ago, buyLinks, creditLink, entryPath, fitLogo, gameLinks, games, KINDS, OS_LABELS, PLATFORMS, platformLogo, shortDate, toolUsers, tools, type Entry } from "../../../lib/data.ts";

export function getStaticPaths() {
  return games.map((entry) => {
    const [owner, repo] = entry.slug.split("/");
    return { params: { owner, repo }, props: { entry } };
  });
}

interface Props {
  entry: Entry;
}
const { entry: e } = Astro.props;
const s = e.snap;
const logo = platformLogo(e.platform);
const logoBox = logo && fitLogo(logo, 160, 40);
const baseName = (g: Entry) => g.game.replace(/ \(.*\)$/, "");
const sameGame = games.filter((g) => g !== e && ((e.wikidata && g.wikidata === e.wikidata) || baseName(g) === baseName(e)));
const m = e.meta;
const related = moreLikeThis(e);
const makers = m && (m.developers.length ? m.developers : m.publishers);
const links = gameLinks(e);
const buy = buyLinks(e);
const tool = e.tool ? tools.find((t) => toolUsers(t).includes(e)) : undefined;
const ai = aiOf(e);
const aiIcon = (vendor: string) => CREDIT_ICONS[vendor];

// Release strip: every release as a dot across the project's lifetime.
const dates = (s?.releaseDates ?? []).map((r) => ({ t: Date.parse(r.date), pre: r.prerelease })).reverse();
const t0 = dates[0]?.t ?? Date.now();
const t1 = Math.max(Date.now(), t0 + 86_400_000);
const sx = (t: number) => 10 + ((t - t0) / (t1 - t0)) * 780;

const facts: [string, string | undefined][] = [
  ["Platform", PLATFORMS[e.platform]],
  ["Kind", KINDS[e.kind]],
  ["Releases", s ? String(s.releaseCount) : undefined],
  ["First release", e.firstReleaseAt && shortDate(e.firstReleaseAt)],
  ["Latest release", e.latestReleaseAt && `${shortDate(e.latestReleaseAt)} (${ago(e.latestReleaseAt)})`],
  ["Last commit", s && ago(s.pushedAt)],
  ["Runs on", e.os.length ? e.os.map((o) => OS_LABELS[o]).join(", ") : undefined],
  ["License", s?.license ?? "none specified"],
  ["GitHub stars", s?.stars.toLocaleString("en")],
];

const description = `${e.game} (${PLATFORMS[e.platform]}) — ${KINDS[e.kind].toLowerCase()} by ${e.repo}. ${s?.description ?? ""}`;
const jsonLd = {
  "@type": "SoftwareApplication",
  name: `${e.game} (${KINDS[e.kind].toLowerCase()})`,
  description,
  url: new URL(entryPath(e), Astro.site).href,
  applicationCategory: "GameApplication",
  operatingSystem: e.os.length ? e.os.map((o) => OS_LABELS[o]).join(", ") : undefined,
  softwareVersion: e.latest?.tag,
  datePublished: e.firstReleaseAt,
  dateModified: e.latestReleaseAt,
  downloadUrl: e.latest?.url,
  image: e.cover && new URL(e.cover.src, Astro.site).href,
  license: s?.license ? `https://spdx.org/licenses/${s.license}` : undefined,
  sameAs: e.url,
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
};
---

<Base title={e.game} description={description} image={e.cover?.src} jsonLd={jsonLd}>
  <div class={e.cover ? "intro with-cover" : "intro"}>
  {e.cover && <img class="cover" src={e.cover.src} width={e.cover.width} height={e.cover.height} alt={`${m?.title ?? e.game} cover`} />}
  <div>
  <div class="head">
    <div>
      <p class="crumbs eyebrow"><a href="/">Games</a> / {PLATFORMS[e.platform]}</p>
      <h1>{e.game}</h1>
    </div>
    {logo && logoBox && <img class="logo-img head-logo" src={logo.src} width={logoBox.w} height={logoBox.h} alt={PLATFORMS[e.platform]} />}
  </div>
  <p class="badges">
    <span class={`badge ${e.kind}`}>{KINDS[e.kind]}</span>
    <span class="badge">{PLATFORMS[e.platform]}</span>
    {s?.archived && <span class="badge">archived</span>}
    {s?.isFork && <span class="badge">fork</span>}
  </p>
  {s?.description && <p class="lede">{s.description}</p>}
  {e.note && <p>{e.note}</p>}
  {
    m && (
      <p class="orig mono">
        Original game: <b>{m.title}</b>
        {m.year && <> · <b>{m.year}</b></>}
        {makers && makers.length > 0 && <> · {makers.join(", ")}</>}
      </p>
    )
  }
  {
    links.length > 0 && (
      <ul class="links">
        {links.map((l) => {
          const icon = LINK_ICONS[l.label];
          return (
            <li>
              <a href={l.href} rel="external">
                {icon && (
                  <svg class={icon.stroke ? "ico stroke" : "ico"} viewBox="0 0 24 24" aria-hidden="true">
                    <path d={icon.d} />
                  </svg>
                )}
                {l.label}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  {
    buy.length > 0 && (
      <div class="buy">
        <span class="buy-label mono" title="Store versions can differ from the release this project needs: check its README for the exact version.">Buy the game</span>
        <ul class="links">
          {buy.map((l) => {
            const icon = LINK_ICONS[l.label];
            return (
              <li>
                <a href={l.href} rel="external">
                  {icon && (
                    <svg class={icon.stroke ? "ico stroke" : "ico"} viewBox="0 0 24 24" aria-hidden="true">
                      <path d={icon.d} />
                    </svg>
                  )}
                  {l.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  <p class="actions">
    {e.latest && <a class="btn primary" href={e.latest.url}>Latest release: {e.latest.tag}</a>}
    <a class="btn" href={e.url}>{e.repo} on GitHub</a>
    {s?.homepage && <a class="btn" href={s.homepage}>Website</a>}
  </p>
  </div>
  </div>

  <div class="cols">
    <section>
      <h2>Facts</h2>
      <dl>
        {
          facts
            .filter(([, v]) => v)
            .map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))
        }
        {
          e.tool && (
            <>
              <dt>Built with</dt>
              <dd>{tool ? <a href={tool.url}>{e.tool}</a> : e.tool}</dd>
            </>
          )
        }
        {
          e.based_on?.length && (
            <>
              <dt>Builds on</dt>
              <dd>
                {e.based_on.map((c, i) => {
                  const l = creditLink(c);
                  return (
                    <>
                      {i > 0 && ", "}
                      <a href={l.href}>{l.label}</a>
                    </>
                  );
                })}
              </dd>
            </>
          )
        }
      </dl>
    </section>

    <section>
      <h2>Recent releases</h2>
      {
        dates.length > 1 && (
          <svg class="strip" viewBox="0 0 800 30" role="img" aria-label={`${dates.length} releases since ${shortDate(new Date(t0).toISOString())}`}>
            <line x1="10" x2="790" y1="15" y2="15" />
            {dates.map((d) => (
              <circle class={`${e.kind}${d.pre ? " pre" : ""}`} cx={sx(d.t)} cy="15" r="5" />
            ))}
          </svg>
        )
      }
      <ol class="releases">
        {
          s?.releases.map((r) => (
            <li>
              <a href={r.url}>{r.name || r.tag}</a>
              {r.prerelease && <span class="badge pre">pre-release</span>}
              <span class="muted">
                {" "}
                · {shortDate(r.publishedAt)}
                {r.os.length > 0 && <> · {r.os.map((o) => OS_LABELS[o]).join(", ")}</>}
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {
    ai?.level && (
      <section class="ai">
        <h2>AI co-authors</h2>
        {ai.credits.length > 0 && (
          <ul class="ai-credits">
            {ai.credits.map((c) => (
              <li class={`v-${c.vendor}${c.versioned ? "" : " unsure"}`} title={`${c.commits} commits, ${shortDate(c.first)} – ${shortDate(c.last)}`}>
                {aiIcon(c.vendor) ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={aiIcon(c.vendor)} />
                  </svg>
                ) : (
                  <span class="ai-dot" />
                )}
                <b>{c.versioned ? shortModel(c.model) : (c.tool ?? c.model)}</b>
                <span class="ai-n">{c.commits.toLocaleString("en")}</span>
                {!c.versioned && <span class="ai-q">{c.likely ? `version not stated · likely ${c.likely}` : "version not stated"}</span>}
              </li>
            ))}
          </ul>
        )}
        <p class="ai-note">
          {ai.credits.length > 0
            ? `${ai.credited.toLocaleString("en")} credits in ${ai.total.toLocaleString("en")} commits since ${shortDate(aiSince)}, read from Co-authored-by lines and agent commits.`
            : `No commit names a model, but the repo keeps instructions for a coding agent: ${ai.files.join(", ")}.`}{" "}
          <a href="/models/">All models</a>
        </p>
      </section>
    )
  }

  {
    sameGame.length > 0 && (
      <section>
        <h2>Other projects for this game</h2>
        <ul>
          {sameGame.map((g) => (
            <li>
              <a href={entryPath(g)}>{g.repo}</a> <span class={`badge ${g.kind}`}>{g.kind}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section>
        <h2>More like this</h2>
        <ul class="related">
          {related.map(({ entry: g, why }) => {
            const l = platformLogo(g.platform);
            const box = l && fitLogo(l, 52, 12);
            return (
              <li>
                <a href={entryPath(g)} class="rel">
                  {g.cover ? <img class="rel-art" src={g.cover.src} width={g.cover.width} height={g.cover.height} alt="" loading="lazy" decoding="async" /> : <span class="rel-art" />}
                  <span class="rel-body">
                    <strong>{g.game}</strong>
                    <span class="rel-why mono">{why}</span>
                    <span class="rel-plat">
                      {l && box ? <img class="logo-img" src={l.src} width={box.w} height={box.h} alt={PLATFORMS[g.platform]} /> : <span class="mono">{PLATFORMS[g.platform]}</span>}
                      <span class={`badge ${g.kind}`}>{g.kind}</span>
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rel {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    padding: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .rel:hover,
  .rel:focus-visible {
    border-color: rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.05);
  }
  .rel-art {
    width: 3.4rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.05);
  }
  .rel-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .rel-body strong {
    font-size: 0.88rem;
    line-height: 1.25;
  }
  .rel-why {
    font-size: 0.68rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rel-why::first-letter {
    text-transform: uppercase;
  }
  .rel-plat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
  }
  .rel-plat .logo-img {
    filter: brightness(0) invert(1);
    opacity: 0.7;
  }
  .intro.with-cover {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 0 1.75rem;
    align-items: start;
  }
  .cover {
    margin-top: 2.5rem;
    width: 160px;
    height: auto;
    border-radius: 7px;
    box-shadow:
      0 18px 40px -16px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(255 255 255 / 0.07);
  }
  @media (max-width: 640px) {
    .intro.with-cover {
      grid-template-columns: 88px 1fr;
      gap: 0 1rem;
    }
    .cover {
      width: 88px;
    }
  }
  .orig {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .orig b {
    color: var(--fg);
    font-weight: 500;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    background: var(--surface);
  }
  .links a:hover {
    color: var(--fg);
    border-color: var(--faint);
  }
  .ico {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    fill: currentColor;
  }
  .ico.stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6rem;
    margin-top: 0.6rem;
  }
  .buy .links {
    margin: 0;
  }
  .buy-label {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .buy .links a {
    color: var(--fg);
    border-color: rgb(124 240 197 / 0.3);
  }
  .buy .links a:hover {
    border-color: rgb(124 240 197 / 0.7);
  }
  .links a::after {
    content: " ↗";
    color: var(--faint);
  }
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .head-logo {
    opacity: 0.35;
    margin-bottom: 1.2rem;
    flex: none;
  }
  @media (max-width: 640px) {
    .head-logo {
      display: none;
    }
  }
  .crumbs {
    margin: 2.5rem 0 0;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs + h1 {
    margin-top: 0.5rem;
  }
  .badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .btn {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.92rem;
    background: var(--surface);
  }
  .btn:hover {
    border-color: var(--muted);
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.82rem;
  }
  .btn.primary {
    background: var(--recomp);
    color: var(--bg);
    border-color: var(--recomp);
    font-weight: 600;
    box-shadow: 0 0 24px -6px rgb(124 240 197 / 0.6);
  }
  .btn.primary:hover {
    border-color: var(--recomp);
    filter: brightness(1.08);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 0 2.5rem;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  dd {
    font-family: var(--mono);
    font-size: 0.85rem;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .strip {
    width: 100%;
    height: auto;
    margin-bottom: 0.5rem;
  }
  .strip circle {
    filter: drop-shadow(0 0 3px currentColor);
  }
  .strip circle.recomp {
    color: var(--recomp);
  }
  .strip circle.port {
    color: var(--port);
  }
  .strip line {
    stroke: var(--line);
    stroke-width: 2;
  }
  .strip circle.recomp {
    fill: var(--recomp);
  }
  .strip circle.port {
    fill: var(--port);
  }
  .strip circle.pre {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .releases {
    padding-left: 1.2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .releases li {
    margin-bottom: 0.3rem;
  }
  .ai-credits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ai-credits li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--mc, var(--line));
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.82rem;
  }
  .ai-credits li.unsure {
    border-style: dashed;
  }
  .ai-credits svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: var(--mc);
  }
  .ai-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--muted);
  }
  .ai-n,
  .ai-q {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .ai-note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .releases .badge {
    margin-left: 0.35rem;
  }
</style>
