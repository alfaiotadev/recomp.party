---
import Base from "../../../layouts/Base.astro";
import { ago, creditLink, entryPath, fitLogo, gameLinks, games, KINDS, OS_LABELS, PLATFORMS, platformLogo, shortDate, toolUsers, tools, type Entry } from "../../../lib/data.ts";

export function getStaticPaths() {
  return games.map((entry) => {
    const [owner, repo] = entry.slug.split("/");
    return { params: { owner, repo }, props: { entry } };
  });
}

interface Props {
  entry: Entry;
}
const { entry: e } = Astro.props;
const s = e.snap;
const logo = platformLogo(e.platform);
const logoBox = logo && fitLogo(logo, 160, 40);
const baseName = (g: Entry) => g.game.replace(/ \(.*\)$/, "");
const sameGame = games.filter((g) => g !== e && ((e.wikidata && g.wikidata === e.wikidata) || baseName(g) === baseName(e)));
const m = e.meta;
const makers = m && (m.developers.length ? m.developers : m.publishers);
const links = gameLinks(e);
const tool = e.tool ? tools.find((t) => toolUsers(t).includes(e)) : undefined;

// Release strip: every release as a dot across the project's lifetime.
const dates = (s?.releaseDates ?? []).map((r) => ({ t: Date.parse(r.date), pre: r.prerelease })).reverse();
const t0 = dates[0]?.t ?? Date.now();
const t1 = Math.max(Date.now(), t0 + 86_400_000);
const sx = (t: number) => 10 + ((t - t0) / (t1 - t0)) * 780;

const facts: [string, string | undefined][] = [
  ["Platform", PLATFORMS[e.platform]],
  ["Kind", KINDS[e.kind]],
  ["Releases", s ? String(s.releaseCount) : undefined],
  ["First release", e.firstReleaseAt && shortDate(e.firstReleaseAt)],
  ["Latest release", e.latestReleaseAt && `${shortDate(e.latestReleaseAt)} (${ago(e.latestReleaseAt)})`],
  ["Last commit", s && ago(s.pushedAt)],
  ["Runs on", e.os.length ? e.os.map((o) => OS_LABELS[o]).join(", ") : undefined],
  ["License", s?.license ?? "none specified"],
  ["GitHub stars", s?.stars.toLocaleString("en")],
];
---

<Base title={e.game} description={`${e.game} (${PLATFORMS[e.platform]}) — ${KINDS[e.kind].toLowerCase()} by ${e.repo}. ${s?.description ?? ""}`}>
  <div class={e.cover ? "intro with-cover" : "intro"}>
  {e.cover && <img class="cover" src={e.cover.src} width={e.cover.width} height={e.cover.height} alt={`${m?.title ?? e.game} cover`} />}
  <div>
  <div class="head">
    <div>
      <p class="crumbs eyebrow"><a href="/">Games</a> / {PLATFORMS[e.platform]}</p>
      <h1>{e.game}</h1>
    </div>
    {logo && logoBox && <img class="logo-img head-logo" src={logo.src} width={logoBox.w} height={logoBox.h} alt={PLATFORMS[e.platform]} />}
  </div>
  <p class="badges">
    <span class={`badge ${e.kind}`}>{KINDS[e.kind]}</span>
    <span class="badge">{PLATFORMS[e.platform]}</span>
    {s?.archived && <span class="badge">archived</span>}
    {s?.isFork && <span class="badge">fork</span>}
  </p>
  {s?.description && <p class="lede">{s.description}</p>}
  {e.note && <p>{e.note}</p>}
  {
    m && (
      <p class="orig mono">
        Original game: <b>{m.title}</b>
        {m.year && <> · <b>{m.year}</b></>}
        {makers && makers.length > 0 && <> · {makers.join(", ")}</>}
      </p>
    )
  }
  {
    links.length > 0 && (
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.href} rel="external">{l.label}</a>
          </li>
        ))}
      </ul>
    )
  }

  <p class="actions">
    {e.latest && <a class="btn primary" href={e.latest.url}>Latest release: {e.latest.tag}</a>}
    <a class="btn" href={e.url}>{e.repo} on GitHub</a>
    {s?.homepage && <a class="btn" href={s.homepage}>Website</a>}
  </p>
  </div>
  </div>

  <div class="cols">
    <section>
      <h2>Facts</h2>
      <dl>
        {
          facts
            .filter(([, v]) => v)
            .map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))
        }
        {
          e.tool && (
            <>
              <dt>Built with</dt>
              <dd>{tool ? <a href={tool.url}>{e.tool}</a> : e.tool}</dd>
            </>
          )
        }
        {
          e.based_on?.length && (
            <>
              <dt>Builds on</dt>
              <dd>
                {e.based_on.map((c, i) => {
                  const l = creditLink(c);
                  return (
                    <>
                      {i > 0 && ", "}
                      <a href={l.href}>{l.label}</a>
                    </>
                  );
                })}
              </dd>
            </>
          )
        }
      </dl>
    </section>

    <section>
      <h2>Recent releases</h2>
      {
        dates.length > 1 && (
          <svg class="strip" viewBox="0 0 800 30" role="img" aria-label={`${dates.length} releases since ${shortDate(new Date(t0).toISOString())}`}>
            <line x1="10" x2="790" y1="15" y2="15" />
            {dates.map((d) => (
              <circle class={`${e.kind}${d.pre ? " pre" : ""}`} cx={sx(d.t)} cy="15" r="5" />
            ))}
          </svg>
        )
      }
      <ol class="releases">
        {
          s?.releases.map((r) => (
            <li>
              <a href={r.url}>{r.name || r.tag}</a>
              {r.prerelease && <span class="badge pre">pre-release</span>}
              <span class="muted">
                {" "}
                · {shortDate(r.publishedAt)}
                {r.os.length > 0 && <> · {r.os.map((o) => OS_LABELS[o]).join(", ")}</>}
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {
    sameGame.length > 0 && (
      <section>
        <h2>Other projects for this game</h2>
        <ul>
          {sameGame.map((g) => (
            <li>
              <a href={entryPath(g)}>{g.repo}</a> <span class={`badge ${g.kind}`}>{g.kind}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .intro.with-cover {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 0 1.75rem;
    align-items: start;
  }
  .cover {
    margin-top: 2.5rem;
    width: 160px;
    height: auto;
    border-radius: 7px;
    box-shadow:
      0 18px 40px -16px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(255 255 255 / 0.07);
  }
  @media (max-width: 640px) {
    .intro.with-cover {
      grid-template-columns: 88px 1fr;
      gap: 0 1rem;
    }
    .cover {
      width: 88px;
    }
  }
  .orig {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .orig b {
    color: var(--fg);
    font-weight: 500;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    background: var(--surface);
  }
  .links a:hover {
    color: var(--fg);
    border-color: var(--faint);
  }
  .links a::after {
    content: " ↗";
    color: var(--faint);
  }
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .head-logo {
    opacity: 0.35;
    margin-bottom: 1.2rem;
    flex: none;
  }
  @media (max-width: 640px) {
    .head-logo {
      display: none;
    }
  }
  .crumbs {
    margin: 2.5rem 0 0;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs + h1 {
    margin-top: 0.5rem;
  }
  .badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .btn {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.92rem;
    background: var(--surface);
  }
  .btn:hover {
    border-color: var(--muted);
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.82rem;
  }
  .btn.primary {
    background: var(--recomp);
    color: var(--bg);
    border-color: var(--recomp);
    font-weight: 600;
    box-shadow: 0 0 24px -6px rgb(124 240 197 / 0.6);
  }
  .btn.primary:hover {
    border-color: var(--recomp);
    filter: brightness(1.08);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 0 2.5rem;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  dd {
    font-family: var(--mono);
    font-size: 0.85rem;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .strip {
    width: 100%;
    height: auto;
    margin-bottom: 0.5rem;
  }
  .strip circle {
    filter: drop-shadow(0 0 3px currentColor);
  }
  .strip circle.recomp {
    color: var(--recomp);
  }
  .strip circle.port {
    color: var(--port);
  }
  .strip line {
    stroke: var(--line);
    stroke-width: 2;
  }
  .strip circle.recomp {
    fill: var(--recomp);
  }
  .strip circle.port {
    fill: var(--port);
  }
  .strip circle.pre {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .releases {
    padding-left: 1.2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .releases li {
    margin-bottom: 0.3rem;
  }
  .releases .badge {
    margin-left: 0.35rem;
  }
</style>
