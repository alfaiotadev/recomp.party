---
import Base from "../layouts/Base.astro";
import { entryPath, fitLogo, PLATFORMS, platformLogo, toolGames, tools, type Entry } from "../lib/data.ts";

/** Game cards shown before the rest fold away behind "Show all". */
const SHOWN = 8;

---

<Base title="Toolchains" description="The static recompilers and runtimes behind the recomps on recomp.party.">
  <p class="eyebrow tl-eyebrow">Under the hood</p>
  <h1>Toolchains</h1>
  <p class="lede">
    The recompilers and runtimes that the game projects are built with. Most recomps pair one of these with a
    game-specific runtime, patches and renderer.
  </p>
  <ul class="tools">
    {
      tools.map((t) => {
        const users = toolGames(t);
        const logo = platformLogo(t.platform);
        const box = logo && fitLogo(logo, 90, 18);
        const cards = (list: Entry[]) => (
          <ul class="games">
            {list.map((u) => (
              <li>
                <a href={entryPath(u)} class={`g ${u.kind}`} title={`${u.game} (${u.repo})`}>
                  {u.cover ? (
                    <img src={u.cover.src} width={u.cover.width} height={u.cover.height} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="ph" />
                  )}
                  <span class="gt">{u.game}</span>
                </a>
              </li>
            ))}
          </ul>
        );
        return (
          <li>
            {logo && box && <img class="logo-img tlogo" src={logo.src} width={box.w} height={box.h} alt={PLATFORMS[t.platform]} />}
            <h2>
              <a href={t.url}>{t.game}</a>
            </h2>
            <p class="meta">
              {PLATFORMS[t.platform]} · {t.repo} · ★ {t.snap?.stars.toLocaleString("en")}
            </p>
            {t.snap?.description && <p>{t.snap.description}</p>}
            {users.length > 0 && (
              <div class="used">
                <p class="used-head mono">
                  Used by {users.length} {users.length === 1 ? "game" : "games"}
                </p>
                {cards(users.slice(0, SHOWN))}
                {users.length > SHOWN && (
                  <details>
                    <summary class="mono">
                      <span class="closed">Show all {users.length}</span>
                      <span class="opened">Show fewer</span>
                    </summary>
                    {cards(users.slice(SHOWN))}
                  </details>
                )}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .tl-eyebrow {
    margin: 2.5rem 0 0;
    color: var(--recomp);
  }
  .tl-eyebrow + h1 {
    margin-top: 0.5rem;
  }
  .tools {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0.9rem;
  }
  .tools > li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
  }
  .tlogo {
    opacity: 0.5;
    margin-bottom: 0.6rem;
  }
  .meta {
    font-family: var(--mono);
    font-size: 0.72rem !important;
    color: var(--faint);
  }
  .tools h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  .tools p {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
  }
  .used {
    padding-top: 0.8rem;
  }
  .used-head {
    margin: 0 0 0.5rem !important;
    font-size: 0.7rem !important;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .games {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.35rem;
  }
  details .games {
    margin-top: 0.35rem;
  }
  .g {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0.25rem 0.45rem 0.25rem 0.25rem;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-left: 2px solid var(--recomp);
    border-radius: 6px;
    text-decoration: none;
    color: var(--fg);
    font-size: 0.76rem;
    line-height: 1.2;
  }
  .g.port {
    border-left-color: var(--port);
  }
  .g:hover {
    background: var(--hover);
  }
  .g img,
  .g .ph {
    flex: none;
    width: 22px;
    aspect-ratio: 3 / 4;
    height: auto;
    border-radius: 2px;
    object-fit: cover;
    background: var(--line);
  }
  .gt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  summary {
    margin-top: 0.45rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.7rem;
    color: var(--recomp);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .opened,
  details[open] .closed {
    display: none;
  }
  details[open] .opened {
    display: inline;
  }
</style>
