---
import Base from "../layouts/Base.astro";
const repo = "https://github.com/alfaiotadev/recomp.party";
/** Pixel cherries for the PixelCherryNinja credit, drawn on a 12×10 grid (one rect per pixel). */
const CHERRY_PALETTE: Record<string, string> = { r: "#e8383d", d: "#a51f2a", w: "#ffffff", s: "#8a5a2b", g: "#46b04a" };
const CHERRY = [
  ".......ssgg.",
  "......s.s.g.",
  ".....s..s...",
  "....s...s...",
  "...s....s...",
  "..s....rr...",
  ".rr...rwrr..",
  "rwrr..rrrd..",
  "rrrd...dd...",
  ".dd.........",
];
const cherryPixels = CHERRY.flatMap((row, y) =>
  [...row].flatMap((c, x) => (CHERRY_PALETTE[c] ? [{ x, y, fill: CHERRY_PALETTE[c] }] : [])),
);
/** MrSujano's running joke: every acronym "stands for Subscribe To MrSujano". Keep these harmless. */
const ACRONYMS = [
  "RPG", "JRPG", "FPS", "NPC", "DLC", "HUD", "MMO", "RTS", "CRT", "ROM", "RAM", "VRAM", "CPU", "GPU", "FMV", "VGA",
  "HDMI", "LAN", "AFK", "GG", "XP", "HP", "DPS", "NES", "SNES", "N64", "GBA", "NDS", "PSP", "PS2", "SDK", "API",
  "FPGA", "ISO", "BIOS",
];
---

<Base title="About" description="What recomp.party tracks, how projects get listed, and how to suggest or opt out.">
  <article class="prose">
    <h1>About recomp.party</h1>
    <p class="lede">
      A plain list of console games you can play natively through a static recompilation or a source port — and a
      timeline of how fast that scene is moving.
    </p>

    <h2>What gets listed</h2>
    <ul>
      <li>
        <strong>Static recompilations</strong> — the game's original machine code is translated ahead of time into a native
        program (for example with N64: Recompiled, XenonRecomp or ReXGlue).
      </li>
      <li>
        <strong>Source ports</strong> — the game is rebuilt from reconstructed source code, usually a community
        decompilation, for modern systems.
      </li>
      <li>
        A project needs at least one <strong>published release</strong> you can download and run with your own copy of the
        game. Work-in-progress repos without builds are left out until they ship.
      </li>
    </ul>

    <h2>What does not</h2>
    <p>
      Decompilation progress. Matching decompilations are research projects with their own communities, and progress
      leaderboards turned out to do more harm than good for them. We don't track percentages or rank anything by
      numbers. When a port builds on a decompilation, the project page credits it.
    </p>
    <p>No game files, ROMs or links to them. Every project listed here requires your own legally obtained copy.</p>

    <h2>How projects get added</h2>
    <p>
      The list lives in <a href={`${repo}/blob/main/data/projects.yaml`}>data/projects.yaml</a>. Each week an automated job
      searches GitHub, the news posts of{" "}
      <a href="https://pixelcherryninja.blogspot.com/" class="pcn"
        >PixelCherryNinja<svg class="cherry" viewBox="0 0 12 10" shape-rendering="crispEdges" aria-hidden="true"
          >{cherryPixels.map((p) => <rect x={p.x} y={p.y} width="1.02" height="1.02" fill={p.fill} />)}</svg
        ></a
      >, the video source lists of{" "}
      <a
        href="https://github.com/MrSujano/Sources/releases"
        class="sujano"
        data-decode-hover="{x} stands for Subscribe To MrSujano"
        data-decode-fill={JSON.stringify(ACRONYMS)}>MrSujano</a
      > and a few other feeds for new candidates, uses an AI model to sort out what is a real,
      playable project, and opens a pull request. A human reviews every entry before it goes live — the AI only
      suggests.
    </p>
    <p>
      Know a project we missed? <a href={`${repo}/issues/new?template=suggest-project.yml`}>Suggest it</a> or open a pull
      request.
    </p>

    <h2>Maintainers: corrections and opt-out</h2>
    <p>
      If your project is listed wrongly, or you'd rather not be listed at all,{" "}
      <a href={`${repo}/issues/new?template=opt-out.yml`}>open an issue</a> and we'll fix or remove it — no questions
      asked.
    </p>

    <h2>A word on downloads</h2>
    <p>
      Every download link points at the project's own GitHub releases; recomp.party hosts nothing. Projects are reviewed
      before they're listed, but builds come from third parties — prefer projects with public source, and be wary of
      anything asking for passwords or pointing to file-sharing sites.
    </p>

    <h2>Data</h2>
    <p>
      Release and repository data comes from the GitHub API and is refreshed every six hours. Supported operating systems
      are guessed from release file names, so they can be wrong. The site itself is static and built with Astro on GitHub
      Actions; <a href={repo}>the source is on GitHub</a>.
    </p>
  </article>
</Base>

<style>
  /* tribute to PixelCherryNinja: logo yellow + pixel cherries */
  .pcn {
    font-family: var(--mono);
    font-size: 0.92em;
    color: #f7c948;
    text-decoration-color: rgb(247 201 72 / 0.4);
    white-space: nowrap;
  }
  .pcn:hover {
    text-shadow: 0 0 10px rgb(247 201 72 / 0.45);
  }
  .cherry {
    display: inline-block;
    width: 1.2em;
    height: 1em;
    margin-left: 0.25em;
    vertical-align: -0.1em;
    filter: drop-shadow(0 0 3px rgb(232 56 61 / 0.45));
  }
  .pcn:hover .cherry {
    animation: cherry-bounce 0.5s steps(3) 2;
  }
  @keyframes cherry-bounce {
    50% {
      transform: translateY(-0.18em) rotate(-8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcn:hover .cherry {
      animation: none;
    }
  }
  .sujano {
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--recomp);
    text-decoration-color: rgb(124 240 197 / 0.4);
  }
  .prose {
    max-width: 46rem;
  }
  .prose h2 {
    margin-top: 2rem;
  }
  .prose li {
    margin-bottom: 0.4rem;
  }
</style>
