---
import GameCard from "../components/GameCard.astro";
import Highlights from "../components/Highlights.astro";
import StatTiles from "../components/StatTiles.astro";
import Timeline from "../components/Timeline.astro";
import Base from "../layouts/Base.astro";
import { aiFilterOptions } from "../lib/ai.ts";
import { fitLogo, games, KINDS, OS_LABELS, PLATFORMS, platformLogo, platformsInUse, toolGames, tools } from "../lib/data.ts";

const osInUse = (Object.keys(OS_LABELS) as (keyof typeof OS_LABELS)[]).filter((o) => games.some((g) => g.os.includes(o)));
const toolStrip = tools.slice(0, 8);
/** Rotated by the decode animation in "New ones ship every …": units of time, ever shorter (a jiffy and a frame are 1/60 s). */
const EVERY = [
  "week", "day", "hour", "minute", "second", "millisecond", "microsecond", "nanosecond",
  "moment", "jiffy", "tick", "frame", "blink of an eye",
];
---

<Base jsonLd={{ "@type": "WebSite", name: "recomp.party", url: "https://recomp.party/" }}>
  <div class="hero">
    <p class="eyebrow">Static recompilations &amp; source ports</p>
    <h1>Classic games, <span class="glow">recompiled</span> to run natively.</h1>
    <p class="lede">
      Console games turned into native PC (and phone) programs. New ones ship every <span class="decode" data-words={JSON.stringify(EVERY)}>week</span> — recomp.party keeps track of
      the ones you can actually play.
    </p>
  </div>

  <StatTiles />

  <Highlights />

  <Timeline games={games} />

  <section aria-labelledby="toolchains">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Under the hood</p>
        <h2 id="toolchains">Toolchains</h2>
      </div>
      <a class="more mono" href="/tools/">All {tools.length} toolchains →</a>
    </div>
    <ul class="tools">
      {
        toolStrip.map((t) => {
          const logo = platformLogo(t.platform);
          const n = toolGames(t).length;
          return (
            <li>
              <a href={t.url}>
                <span class="tool-top">
                  {logo ? <img class="logo-img" src={logo.src} width={fitLogo(logo, 80, 16).w} height={fitLogo(logo, 80, 16).h} alt={PLATFORMS[t.platform]} loading="lazy" /> : <span class="mono muted">{PLATFORMS[t.platform]}</span>}
                </span>
                <strong>{t.game}</strong>
                <span class="mono muted">{n > 0 ? `${n} ${n === 1 ? "game" : "games"} here` : `★ ${t.snap?.stars.toLocaleString("en")}`}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section aria-labelledby="all-games">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Sorted by latest release</p>
        <h2 id="all-games">All games</h2>
      </div>
      <form class="filters" id="filters" role="search" onsubmit="return false">
        <label class="visually-hidden" for="f-q">Search</label>
        <input id="f-q" name="q" type="search" placeholder="Search games…" autocomplete="off" />
        <label class="visually-hidden" for="f-platform">Platform</label>
        <select id="f-platform" name="platform">
          <option value="">All platforms</option>
          {platformsInUse.map((p) => <option value={p}>{PLATFORMS[p]}</option>)}
        </select>
        <label class="visually-hidden" for="f-kind">Kind</label>
        <select id="f-kind" name="kind">
          <option value="">Recomps &amp; ports</option>
          <option value="recomp">{KINDS.recomp}</option>
          <option value="port">{KINDS.port}</option>
        </select>
        <label class="visually-hidden" for="f-ai">AI co-author</label>
        <select id="f-ai" name="ai" title="Model or agent credited in the project's commits">
          <option value="">Any AI co-author</option>
          {aiFilterOptions.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
        <label class="visually-hidden" for="f-os">Runs on</label>
        <select id="f-os" name="os">
          <option value="">Any OS</option>
          {osInUse.map((o) => <option value={o}>{OS_LABELS[o]}</option>)}
        </select>
      </form>
    </div>
    <div class="list-bar">
      <p class="muted count mono" id="count" aria-live="polite">{games.length} games</p>
      <div class="views" role="group" aria-label="Layout">
        <button type="button" data-layout="list" aria-pressed="false" title="List">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12" /></svg>
        </button>
        <button type="button" data-layout="one" class="phone-only" aria-pressed="false" title="One column">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="10" height="12" rx="1.5" /></svg>
        </button>
        <button type="button" data-layout="grid" aria-pressed="true" title="Grid">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" /><rect x="9" y="2" width="5" height="5" rx="1" /><rect x="2" y="9" width="5" height="5" rx="1" /><rect x="9" y="9" width="5" height="5" rx="1" /></svg>
        </button>
      </div>
    </div>
    <ul class="grid" id="games">
      {games.map((g) => <GameCard entry={g} />)}
    </ul>
  </section>
</Base>

<script is:inline>
  (() => {
    const form = document.getElementById("filters");
    const cards = [...document.querySelectorAll("#games > li")];
    const count = document.getElementById("count");
    const apply = () => {
      const f = Object.fromEntries(new FormData(form));
      const q = (f.q || "").trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const d = c.dataset;
        const ok =
          (!f.platform || d.platform === f.platform) &&
          (!f.kind || d.kind === f.kind) &&
          (!f.os || d.os.split(" ").includes(f.os)) &&
          (!f.ai || d.ai.split(" ").includes(f.ai)) &&
          (!q || d.search.includes(q));
        c.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = shown === cards.length ? `${cards.length} games` : `${shown} of ${cards.length} games`;
    };
    form.addEventListener("input", apply);
    // Layout: list, one column (phones) or the card grid; remembered per browser.
    const list = document.getElementById("games");
    const buttons = [...document.querySelectorAll(".views button")];
    const setLayout = (mode) => {
      list.classList.remove("list", "one");
      if (mode !== "grid") list.classList.add(mode);
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.layout === mode));
    };
    for (const b of buttons)
      b.addEventListener("click", () => {
        setLayout(b.dataset.layout);
        try {
          localStorage.setItem("games-layout", b.dataset.layout);
        } catch {}
      });
    try {
      const saved = localStorage.getItem("games-layout");
      if (saved === "list" || saved === "one") setLayout(saved);
    } catch {}
    // ?q=… (e.g. from "Most recompiled games") pre-fills the search
    const params = new URLSearchParams(location.search);
    const q = params.get("q");
    if (q) form.elements.namedItem("q").value = q;
    // ?ai=… (from the Models page) picks a model or vendor
    const ai = params.get("ai");
    if (ai && form.elements.namedItem("ai").querySelector(`option[value="${CSS.escape(ai)}"]`)) form.elements.namedItem("ai").value = ai;
    if (q || ai) apply();
  })();
</script>

<style>
  .hero {
    padding-top: 1rem;
  }
  .hero .eyebrow {
    margin: 2.5rem 0 0;
    color: var(--recomp);
  }
  .hero h1 {
    margin-top: 0.6rem;
    text-wrap: balance;
  }
  .hero .lede {
    max-width: 62rem;
    text-wrap: pretty;
  }
  .hero .decode {
    color: var(--recomp);
    text-shadow: 0 0 10px rgb(124 240 197 / 0.45);
    white-space: nowrap;
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .sec-head h2 {
    margin: 0.2rem 0 0;
  }
  .more {
    font-size: 0.8rem;
    color: var(--recomp);
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  .tools {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.6rem;
  }
  .tools a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.8rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .tools a:hover {
    border-color: rgb(169 180 255 / 0.5);
  }
  .tool-top {
    height: 16px;
    margin-bottom: 0.35rem;
  }
  .tool-top img {
    opacity: 0.6;
  }
  .tool-top .mono {
    font-size: 0.68rem;
  }
  .tools strong {
    font-size: 0.95rem;
  }
  .tools .mono {
    font-size: 0.7rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filters input,
  .filters select {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.45rem 0.6rem;
  }
  .filters input:focus,
  .filters select:focus {
    border-color: rgb(124 240 197 / 0.5);
    outline: none;
  }
  .filters input {
    min-width: 13rem;
  }
  @media (max-width: 720px) {
    .filters,
    .filters input {
      width: 100%;
    }
    .filters select {
      flex: 1;
    }
  }
  .list-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: -0.4rem 0 0.8rem;
  }
  .count {
    font-size: 0.72rem;
    margin: 0;
  }
  .views {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
  }
  .views button {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.6rem;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .views button:hover {
    color: var(--fg);
  }
  .views button[aria-pressed="true"] {
    background: var(--surface-2);
    color: var(--recomp);
    box-shadow: inset 0 0 0 1px rgb(124 240 197 / 0.3);
  }
  .views svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  /* one column is a phone layout; on wider screens the grid already fits several */
  .phone-only {
    display: none !important;
  }
  .grid.list {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
  }
  @media (max-width: 720px) {
    .phone-only {
      display: grid !important;
    }
    .grid.one {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.7rem;
    padding: 0;
    margin: 0;
  }
</style>
