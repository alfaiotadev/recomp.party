---
import GameCard from "../components/GameCard.astro";
import Highlights from "../components/Highlights.astro";
import StatTiles from "../components/StatTiles.astro";
import Timeline from "../components/Timeline.astro";
import Base from "../layouts/Base.astro";
import { ago, fitLogo, games, generatedAt, KINDS, OS_LABELS, PLATFORMS, platformLogo, platformsInUse, toolUsers, tools } from "../lib/data.ts";

const osInUse = (Object.keys(OS_LABELS) as (keyof typeof OS_LABELS)[]).filter((o) => games.some((g) => g.os.includes(o)));
const toolStrip = tools.slice(0, 8);
---

<Base>
  <div class="hero">
    <p class="eyebrow">Static recompilations &amp; source ports</p>
    <h1>Classic games, <span class="glow">recompiled</span> to run natively.</h1>
    <p class="lede">
      Console games turned into native PC (and phone) programs. New ones ship every week — recomp.party keeps track of
      the ones you can actually play.
    </p>
  </div>

  <StatTiles />
  <p class="refreshed mono">data refreshed {ago(generatedAt)}</p>

  <Highlights />

  <Timeline games={games} />

  <section aria-labelledby="toolchains">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Under the hood</p>
        <h2 id="toolchains">Toolchains</h2>
      </div>
      <a class="more mono" href="/tools/">All {tools.length} toolchains →</a>
    </div>
    <ul class="tools">
      {
        toolStrip.map((t) => {
          const logo = platformLogo(t.platform);
          const n = toolUsers(t).length;
          return (
            <li>
              <a href={t.url}>
                <span class="tool-top">
                  {logo ? <img class="logo-img" src={logo.src} width={fitLogo(logo, 80, 16).w} height={fitLogo(logo, 80, 16).h} alt={PLATFORMS[t.platform]} loading="lazy" /> : <span class="mono muted">{PLATFORMS[t.platform]}</span>}
                </span>
                <strong>{t.game}</strong>
                <span class="mono muted">{n > 0 ? `${n} ${n === 1 ? "game" : "games"} here` : `★ ${t.snap?.stars.toLocaleString("en")}`}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section aria-labelledby="all-games">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Sorted by latest release</p>
        <h2 id="all-games">All games</h2>
      </div>
      <form class="filters" id="filters" role="search" onsubmit="return false">
        <label class="visually-hidden" for="f-q">Search</label>
        <input id="f-q" name="q" type="search" placeholder="Search games…" autocomplete="off" />
        <label class="visually-hidden" for="f-platform">Platform</label>
        <select id="f-platform" name="platform">
          <option value="">All platforms</option>
          {platformsInUse.map((p) => <option value={p}>{PLATFORMS[p]}</option>)}
        </select>
        <label class="visually-hidden" for="f-kind">Kind</label>
        <select id="f-kind" name="kind">
          <option value="">Recomps &amp; ports</option>
          <option value="recomp">{KINDS.recomp}</option>
          <option value="port">{KINDS.port}</option>
        </select>
        <label class="visually-hidden" for="f-os">Runs on</label>
        <select id="f-os" name="os">
          <option value="">Any OS</option>
          {osInUse.map((o) => <option value={o}>{OS_LABELS[o]}</option>)}
        </select>
      </form>
    </div>
    <p class="muted count mono" id="count" aria-live="polite">{games.length} games</p>
    <ul class="grid" id="games">
      {games.map((g) => <GameCard entry={g} />)}
    </ul>
  </section>
</Base>

<script is:inline>
  (() => {
    const form = document.getElementById("filters");
    const cards = [...document.querySelectorAll("#games > li")];
    const count = document.getElementById("count");
    const apply = () => {
      const f = Object.fromEntries(new FormData(form));
      const q = (f.q || "").trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const d = c.dataset;
        const ok =
          (!f.platform || d.platform === f.platform) &&
          (!f.kind || d.kind === f.kind) &&
          (!f.os || d.os.split(" ").includes(f.os)) &&
          (!q || d.search.includes(q));
        c.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = shown === cards.length ? `${cards.length} games` : `${shown} of ${cards.length} games`;
    };
    form.addEventListener("input", apply);
  })();
</script>

<style>
  .hero {
    padding-top: 1rem;
  }
  .hero .eyebrow {
    margin: 2.5rem 0 0;
    color: var(--recomp);
  }
  .hero h1 {
    margin-top: 0.6rem;
    text-wrap: balance;
  }
  .hero .lede {
    max-width: 62rem;
    text-wrap: pretty;
  }
  .refreshed {
    margin: 0.5rem 0 0;
    font-size: 0.7rem;
    color: var(--faint);
    text-align: right;
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .sec-head h2 {
    margin: 0.2rem 0 0;
  }
  .more {
    font-size: 0.8rem;
    color: var(--recomp);
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  .tools {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.6rem;
  }
  .tools a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.8rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .tools a:hover {
    border-color: rgb(169 180 255 / 0.5);
  }
  .tool-top {
    height: 16px;
    margin-bottom: 0.35rem;
  }
  .tool-top img {
    opacity: 0.6;
  }
  .tool-top .mono {
    font-size: 0.68rem;
  }
  .tools strong {
    font-size: 0.95rem;
  }
  .tools .mono {
    font-size: 0.7rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filters input,
  .filters select {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.45rem 0.6rem;
  }
  .filters input:focus,
  .filters select:focus {
    border-color: rgb(124 240 197 / 0.5);
    outline: none;
  }
  .filters input {
    min-width: 13rem;
  }
  @media (max-width: 720px) {
    .filters,
    .filters input {
      width: 100%;
    }
    .filters select {
      flex: 1;
    }
  }
  .count {
    font-size: 0.72rem;
    margin: -0.4rem 0 0.8rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.7rem;
    padding: 0;
    margin: 0;
  }
</style>
